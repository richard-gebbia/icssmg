module Msg exposing (..)

import Ids exposing (ID)
import Random
import Stat exposing (Stat)


type Msg
    = GeneratedInitialSeed Random.Seed
    | PlayerPutPointIntoQuestReq { questId : ID, reqIdx : Int, stat : Stat }
    | PlayerPutWildPointIntoQuestReq { questId : ID, reqIdx : Int }
    | PlayerPutMaxPointsIntoQuestReq { questId : ID, reqIdx : Int, stat : Stat }
    | PlayerRemovesPointFromQuestReq { questId : ID, reqIdx : Int, stat : Stat }
    | PlayerRemovesWildPointFromQuestReq { questId : ID, reqIdx : Int }
    | PlayerRemovesAllPointsFromQuestReq { questId : ID, reqIdx : Int, stat : Stat }
    | PlayerCommitsCurrentCycle
    | CommitCycleAnimationEnds
