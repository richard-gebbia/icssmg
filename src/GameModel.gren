easyProcedural : QuestGenerator
easyProcedural =
    QuestGen
        (\game seed _extraData ->
            let
                titleAndSeed =
                    Random.step randomSciFiQuestNames seed

                points =
                    playerNextCycleStatsDesc game

                toRandomWeight : { stat : Stat, amount : Int } -> { weight : Float, value : Stat }
                toRandomWeight { stat, amount } =
                    { weight = toFloat (max amount 1), value = stat }

                weightedStatGenerator : Random.Generator Stat
                weightedStatGenerator =
                    points
                        |> Array.popFirst
                        |> Maybe.map (\{ first, rest } -> Random.weighted (toRandomWeight first) (Array.map toRandomWeight rest))
                        |> Maybe.withDefault randomStat

                statAndSeed =
                    Random.step weightedStatGenerator titleAndSeed.seed

                rewardAndSeed =
                    Random.step randomStat statAndSeed.seed
            in
            { quest =
                { title = titleAndSeed.value ++ " " ++ romanNumeral game.player.level
                , requirements = [ QuestReq.init statAndSeed.value (game.player.level * 2) ]
                , duration = Duration.Temp { cyclesLeft = 3 }
                , completionEffects =
                    [ CycleStartEffect.PlayerGetsPoints
                        { stat = rewardAndSeed.value
                        , amount = game.player.level * 2
                        , duration = Duration.Temp { cyclesLeft = 1 }
                        }
                    ]
                , expirationEffects = []
                , isRecurring = False
                }
            , randomSeed = rewardAndSeed.seed
            }
        )


mediumProcedural : QuestGenerator
mediumProcedural =
    QuestGen
        (\game seed _extraData ->
            let
                titleAndSeed =
                    Random.step randomSciFiQuestNames seed

                points =
                    playerNextCycleStatsDesc game

                toRandomWeight : { stat : Stat, amount : Int } -> { weight : Float, value : Stat }
                toRandomWeight { stat, amount } =
                    { weight = toFloat (max amount 1), value = stat }

                weightedStatGenerator : Random.Generator Stat
                weightedStatGenerator =
                    points
                        |> Array.popFirst
                        |> Maybe.map (\{ first, rest } -> Random.weighted (toRandomWeight first) (Array.map toRandomWeight rest))
                        |> Maybe.withDefault randomStat

                statAndSeed1 =
                    Random.step weightedStatGenerator titleAndSeed.seed

                statAndSeed2 =
                    Random.step weightedStatGenerator statAndSeed1.seed

                requirements =
                    if statAndSeed1.value == statAndSeed2.value then
                        [ QuestReq.init statAndSeed1.value (game.player.level * 4) ]

                    else
                        [ QuestReq.init statAndSeed1.value (game.player.level * 2)
                        , QuestReq.init statAndSeed2.value (game.player.level * 2)
                        ]

                rewardAndSeed1 =
                    Random.step randomStat statAndSeed2.seed

                rewardAndSeed2 =
                    Random.step randomStat rewardAndSeed1.seed

                rewards =
                    if rewardAndSeed1.value == rewardAndSeed2.value then
                        [ CycleStartEffect.PlayerGetsPoints
                            { stat = rewardAndSeed1.value
                            , amount = game.player.level * 6
                            , duration = Duration.Temp { cyclesLeft = 3 }
                            }
                        ]

                    else
                        [ CycleStartEffect.PlayerGetsPoints
                            { stat = rewardAndSeed1.value
                            , amount = game.player.level * 3
                            , duration = Duration.Temp { cyclesLeft = 3 }
                            }
                        , CycleStartEffect.PlayerGetsPoints
                            { stat = rewardAndSeed2.value
                            , amount = game.player.level * 3
                            , duration = Duration.Temp { cyclesLeft = 3 }
                            }
                        ]
            in
            { quest =
                { title = titleAndSeed.value ++ " " ++ romanNumeral game.player.level
                , requirements = requirements
                , duration = Duration.Temp { cyclesLeft = 5 }
                , completionEffects = rewards
                , expirationEffects = []
                , isRecurring = False
                }
            , randomSeed = rewardAndSeed2.seed
            }
        )


hardProcedural : QuestGenerator
hardProcedural =
    QuestGen
        (\game seed _extraData ->
            let
                titleAndSeed =
                    Random.step randomSciFiQuestNames seed

                points =
                    playerNextCycleStatsDesc game

                toRandomWeight : { stat : Stat, amount : Int } -> { weight : Float, value : Stat }
                toRandomWeight { stat, amount } =
                    { weight = toFloat (max amount 1), value = stat }

                weightedStatGenerator : Random.Generator Stat
                weightedStatGenerator =
                    points
                        |> Array.popFirst
                        |> Maybe.map (\{ first, rest } -> Random.weighted (toRandomWeight first) (Array.map toRandomWeight rest))
                        |> Maybe.withDefault randomStat

                statAndSeed1 =
                    Random.step weightedStatGenerator titleAndSeed.seed

                statAndSeed2 =
                    Random.step weightedStatGenerator statAndSeed1.seed

                statAndSeed3 =
                    Random.step weightedStatGenerator statAndSeed2.seed

                requirements =
                    if statAndSeed1.value == statAndSeed2.value && statAndSeed2.value == statAndSeed3.value then
                        [ QuestReq.init statAndSeed1.value (game.player.level * 6) ]

                    else if statAndSeed1.value == statAndSeed2.value then
                        [ QuestReq.init statAndSeed1.value (game.player.level * 4)
                        , QuestReq.init statAndSeed3.value (game.player.level * 2)
                        ]

                    else if statAndSeed2.value == statAndSeed3.value then
                        [ QuestReq.init statAndSeed1.value (game.player.level * 2)
                        , QuestReq.init statAndSeed2.value (game.player.level * 4)
                        ]

                    else if statAndSeed1.value == statAndSeed3.value then
                        [ QuestReq.init statAndSeed1.value (game.player.level * 4)
                        , QuestReq.init statAndSeed2.value (game.player.level * 2)
                        ]

                    else
                        [ QuestReq.init statAndSeed1.value (game.player.level * 2)
                        , QuestReq.init statAndSeed2.value (game.player.level * 2)
                        , QuestReq.init statAndSeed3.value (game.player.level * 2)
                        ]

                rewardAndSeed1 =
                    Random.step randomStat statAndSeed2.seed

                rewardAndSeed2 =
                    Random.step randomStat rewardAndSeed1.seed

                rewardAndSeed3 =
                    Random.step randomStat rewardAndSeed2.seed

                rewards =
                    if rewardAndSeed1.value == rewardAndSeed2.value then
                        [ CycleStartEffect.PlayerGetsPoints
                            { stat = rewardAndSeed1.value
                            , amount = game.player.level * 9
                            , duration = Duration.Temp { cyclesLeft = 5 }
                            }
                        ]

                    else if rewardAndSeed1.value == rewardAndSeed2.value then
                        [ CycleStartEffect.PlayerGetsPoints
                            { stat = rewardAndSeed1.value
                            , amount = game.player.level * 6
                            , duration = Duration.Temp { cyclesLeft = 9 }
                            }
                        , CycleStartEffect.PlayerGetsPoints
                            { stat = rewardAndSeed3.value
                            , amount = game.player.level * 3
                            , duration = Duration.Temp { cyclesLeft = 9 }
                            }
                        ]

                    else if rewardAndSeed2.value == rewardAndSeed3.value then
                        [ CycleStartEffect.PlayerGetsPoints
                            { stat = rewardAndSeed1.value
                            , amount = game.player.level * 3
                            , duration = Duration.Temp { cyclesLeft = 9 }
                            }
                        , CycleStartEffect.PlayerGetsPoints
                            { stat = rewardAndSeed2.value
                            , amount = game.player.level * 6
                            , duration = Duration.Temp { cyclesLeft = 9 }
                            }
                        ]

                    else if rewardAndSeed1.value == rewardAndSeed3.value then
                        [ CycleStartEffect.PlayerGetsPoints
                            { stat = rewardAndSeed1.value
                            , amount = game.player.level * 6
                            , duration = Duration.Temp { cyclesLeft = 9 }
                            }
                        , CycleStartEffect.PlayerGetsPoints
                            { stat = rewardAndSeed2.value
                            , amount = game.player.level * 3
                            , duration = Duration.Temp { cyclesLeft = 9 }
                            }
                        ]

                    else
                        [ CycleStartEffect.PlayerGetsPoints
                            { stat = rewardAndSeed1.value
                            , amount = game.player.level * 3
                            , duration = Duration.Temp { cyclesLeft = 3 }
                            }
                        , CycleStartEffect.PlayerGetsPoints
                            { stat = rewardAndSeed2.value
                            , amount = game.player.level * 3
                            , duration = Duration.Temp { cyclesLeft = 3 }
                            }
                        ]
            in
            { quest =
                { title = titleAndSeed.value ++ " " ++ romanNumeral game.player.level
                , requirements = requirements
                , duration = Duration.Temp { cyclesLeft = 8 }
                , completionEffects = rewards
                , expirationEffects = []
                , isRecurring = False
                }
            , randomSeed = rewardAndSeed3.seed
            }
        )


romanNumeral : Int -> String
romanNumeral x =
    let
        aux : Int -> String -> String
        aux y soFar =
            if 1000 <= y then
                aux (y - 1000) (soFar ++ "M")

            else if 900 <= y then
                aux (y - 900) (soFar ++ "CM")

            else if 500 <= y then
                aux (y - 500) (soFar ++ "D")

            else if 400 <= y then
                aux (y - 400) (soFar ++ "CD")

            else if 100 <= y then
                aux (y - 100) (soFar ++ "C")

            else if 90 <= y then
                aux (y - 90) (soFar ++ "XC")

            else if 50 <= y then
                aux (y - 50) (soFar ++ "L")

            else if 40 <= y then
                aux (y - 40) (soFar ++ "XL")

            else if 10 <= y then
                aux (y - 10) (soFar ++ "X")

            else if 9 <= y then
                aux (y - 9) (soFar ++ "IX")

            else if 5 <= y then
                aux (y - 5) (soFar ++ "V")

            else if 4 <= y then
                aux (y - 4) (soFar ++ "IV")

            else if 1 <= y then
                aux (y - 1) (soFar ++ "I")

            else
                soFar
    in
    aux x ""


