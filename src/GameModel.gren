module GameModel exposing (..)

import CycleStartEffect exposing (CycleStartEffect)
import Duration exposing (Duration)
import Player exposing (Player)
import Quest exposing (Quest)
import Quest.Requirement as QuestReq
import Stat exposing (Stat)


type alias GameModel =
    { player : Player
    , quests : Array Quest
    , phase : Phase
    , effects : Array CycleStartEffect
    }


type Phase
    = DistributingWilds { wildsLeft : Int, totalWilds : Int }
    | SpendingPoints { totalWilds : Int }


init : GameModel
init =
    { player =
        { hp = 10
        , maxHP = 10
        , level = 0
        , pink = 0
        , yellow = 0
        , green = 2
        , blue = 1
        , purple = 0
        , white = 0
        , pinkTotalForCycle = 0
        , yellowTotalForCycle = 0
        , greenTotalForCycle = 2
        , blueTotalForCycle = 1
        , purpleTotalForCycle = 0
        , whiteTotalForCycle = 0
        }
    , quests =
        [ { title = "First Quest"
          , requirements = [ QuestReq.init Stat.Blue 1 ]
          , duration = Duration.Permanent
          , completionEffects = [ CycleStartEffect.PlayerLevelsUp ]
          }
        , { title = "Second Quest"
          , requirements =
                [ QuestReq.init Stat.Green 4 |> QuestReq.withPointsAdded 1 |> QuestReq.cycleStartState
                , QuestReq.init Stat.Pink 3 |> QuestReq.withPointsAdded 2 |> QuestReq.cycleStartState
                , QuestReq.init Stat.Purple 1 |> QuestReq.withPointsAdded 1 |> QuestReq.cycleStartState
                ]
          , duration = Duration.Temp { cyclesLeft = 3 }
          , completionEffects =
            [ CycleStartEffect.PlayerGetsPoints { stat = Stat.Green, amount = 2, duration = Duration.Temp { cyclesLeft = 2 } }
            , CycleStartEffect.PlayerGetsPoints { stat = Stat.White, amount = 1, duration = Duration.Temp { cyclesLeft = 1 } }
            , CycleStartEffect.PlayerGetsPoints { stat = Stat.Pink, amount = 3, duration = Duration.Permanent }
            ]
          }
        ]
    , effects =
        [ CycleStartEffect.PlayerGetsPoints { stat = Stat.Yellow, amount = 2, duration = Duration.Temp { cyclesLeft = 3 } }
        , CycleStartEffect.PlayerHeals { amount = 2 }
        , CycleStartEffect.PlayerMaxHPChanges { amount = -1 }
        , CycleStartEffect.PlayerLevelsUp
        , CycleStartEffect.PlayerLevelsUp
        ]
    , phase = SpendingPoints { totalWilds = 1 }
    }


cycleStartState : GameModel -> GameModel
cycleStartState { player, quests, effects } =
    let
        playerAtCycleStart : Player
        playerAtCycleStart =
            Player.cycleStartState player

        wilds : Int
        wilds =
            Array.foldl
                (\effect numWilds ->
                    when effect is
                        CycleStartEffect.PlayerGetsWildPoints { amount } ->
                            numWilds + amount

                        CycleStartEffect.PlayerLevelsUp ->
                            numWilds + 1

                        _ ->
                            numWilds
                )
                playerAtCycleStart.level
                effects

        newEffects : Array CycleStartEffect
        newEffects =
            Array.mapAndKeepJust
                (\effect ->
                    when effect is
                        CycleStartEffect.PlayerGetsPoints effect_ ->
                            when effect_.duration is
                                Duration.Temp { cyclesLeft } ->
                                    if cyclesLeft <= 1 then
                                        Nothing

                                    else
                                        Just
                                            (CycleStartEffect.PlayerGetsPoints
                                                { effect_
                                                | duration = Duration.Temp { cyclesLeft = cyclesLeft - 1 }
                                                }
                                            )

                                Duration.Permanent ->
                                    Just effect

                        CycleStartEffect.PlayerGetsWildPoints effect_ ->
                            when effect_.duration is
                                Duration.Temp { cyclesLeft } ->
                                    if cyclesLeft <= 1 then
                                        Nothing

                                    else
                                        Just
                                            (CycleStartEffect.PlayerGetsWildPoints
                                                { effect_
                                                | duration = Duration.Temp { cyclesLeft = cyclesLeft - 1 }
                                                }
                                            )

                                Duration.Permanent ->
                                    Just effect

                        CycleStartEffect.PlayerLevelsUp ->
                            Nothing

                        CycleStartEffect.PlayerHeals _ ->
                            Nothing

                        CycleStartEffect.PlayerMaxHPChanges _ ->
                            Nothing

                        CycleStartEffect.PlayerTakesDamage _ ->
                            Nothing
                )
                effects

        playerWithNewPointsAndLevel : Player
        playerWithNewPointsAndLevel =
            Array.foldl
                (\effect playerIter ->
                    when effect is
                        CycleStartEffect.PlayerLevelsUp ->
                            { playerIter | level = playerIter.level + 1 }

                        CycleStartEffect.PlayerGetsPoints { stat, amount } ->
                            Player.withPointsChanged stat (\points -> points + amount) playerIter

                        _ ->
                            playerIter
                )
                playerAtCycleStart
                effects

        -- TODO: change HP and max HP

        newQuests : Array Quest
        newQuests =
            Array.mapAndKeepJust
                (\quest ->
                    when quest.duration is
                        Duration.Temp { cyclesLeft } ->
                            if cyclesLeft <= 1 then
                                Nothing

                            else
                                Just { quest | duration = Duration.Temp { cyclesLeft = cyclesLeft - 1 } }

                        Duration.Permanent ->
                            Just quest
                )
                quests
    in
    { player = playerWithNewPointsAndLevel
    , quests = newQuests
    , phase = DistributingWilds { wildsLeft = wilds, totalWilds = wilds }
    , effects = newEffects
    }


doesPlayerMeetQuestRequirements : Player -> Quest -> Bool
doesPlayerMeetQuestRequirements player quest =
    Array.all
        (\requirement -> QuestReq.total requirement <= Player.pointsForStat (QuestReq.stat requirement) player)
        quest.requirements


withQuestCompleted : Int -> GameModel -> GameModel
withQuestCompleted questIdx gameModel =
    let
        quest : Maybe Quest
        quest =
            Array.get questIdx gameModel.quests

        newPlayer : Player
        newPlayer =
            quest
                |> Maybe.map
                    (\{ requirements } ->
                        Array.foldl
                            (\requirement playerIter ->
                                Player.withPointsChanged
                                    (QuestReq.stat requirement)
                                    (\points -> points - QuestReq.total requirement)
                                    playerIter
                            )
                            gameModel.player
                            requirements
                    )
                |> Maybe.withDefault gameModel.player
    in
    { gameModel
    | player = newPlayer
    , quests = Array.indexedKeepIf (\idx _ -> not (idx == questIdx)) gameModel.quests
    }


withPlayerPuttingPointsIntoQuestReq : Int -> Int -> Stat -> Int -> GameModel -> GameModel
withPlayerPuttingPointsIntoQuestReq questIdx reqIdx stat points gameModel =
    { gameModel
    | player = Player.withPointsChanged stat (\oldPoints -> oldPoints - points) gameModel.player
    , quests = Array.update questIdx (Quest.withPointsTowardRequirement points reqIdx) gameModel.quests
    }


withPlayerPuttingMaxPointsIntoQuestReq : Int -> Int -> Stat -> GameModel -> GameModel
withPlayerPuttingMaxPointsIntoQuestReq questIdx reqIdx stat gameModel =
    let
        pointsNeeded : Int
        pointsNeeded =
            Array.get questIdx gameModel.quests
                |> Maybe.map (Quest.pointsNeededToCompleteReq reqIdx)
                |> Maybe.withDefault 0

        pointsHeld : Int
        pointsHeld =
            Player.pointsForStat stat gameModel.player

        points : Int
        points =
            min pointsNeeded pointsHeld
    in
    { gameModel
    | player = Player.withPointsChanged stat (\oldPoints -> oldPoints - points) gameModel.player
    , quests = Array.update questIdx (Quest.withPointsTowardRequirement points reqIdx) gameModel.quests
    }


withPlayerRemovingPointsFromQuestReq : Int -> Int -> Stat -> Int -> GameModel -> GameModel
withPlayerRemovingPointsFromQuestReq questIdx reqIdx stat points gameModel =
    { gameModel
    | player = Player.withPointsChanged stat (\oldPoints -> oldPoints + points) gameModel.player
    , quests = Array.update questIdx (Quest.withPointsRemovedFromRequirement points reqIdx) gameModel.quests
    }


withPlayerRemovingAllPiontsFromQuestReq : Int -> Int -> Stat -> GameModel -> GameModel
withPlayerRemovingAllPiontsFromQuestReq questIdx reqIdx stat gameModel =
    let
        points : Int
        points =
            Array.get questIdx gameModel.quests
                |> Maybe.map (Quest.pointsAddedInCurrentCycle reqIdx)
                |> Maybe.withDefault 0
    in
    { gameModel
    | player = Player.withPointsChanged stat (\oldPoints -> oldPoints + points) gameModel.player
    , quests = Array.update questIdx (Quest.withPointsRemovedFromRequirement points reqIdx) gameModel.quests
    }


pointsForStatNextCycle : Stat -> GameModel -> Int
pointsForStatNextCycle stat gameModel =
    Array.foldl
        (\effect count ->
            when effect is
                CycleStartEffect.PlayerGetsPoints effect_ ->
                    if effect_.stat == stat then
                        when effect_.duration is
                            Duration.Temp { cyclesLeft } ->
                                if 1 < cyclesLeft then
                                    count + effect_.amount

                                else
                                    count

                            Duration.Permanent ->
                                count + effect_.amount

                    else
                        count

                _ ->
                    count
        )
        0
        gameModel.effects


wildsLeftThisCycle : GameModel -> Int
wildsLeftThisCycle gameModel =
    when gameModel.phase is
        DistributingWilds { wildsLeft } ->
            wildsLeft

        SpendingPoints _ ->
            0


totalWildsThisCycle : GameModel -> Int
totalWildsThisCycle gameModel =
    when gameModel.phase is
        DistributingWilds { totalWilds } ->
            totalWilds

        SpendingPoints { totalWilds } ->
            totalWilds


wildsNextCycle : GameModel -> Int
wildsNextCycle gameModel =
    Array.foldl
        (\effect count ->
            when effect is
                CycleStartEffect.PlayerGetsWildPoints { amount, duration } ->
                    when duration is
                        Duration.Temp { cyclesLeft } ->
                            if 1 < cyclesLeft then
                                count + amount

                            else
                                count

                        Duration.Permanent ->
                            count + amount

                CycleStartEffect.PlayerLevelsUp ->
                    count + 1

                _ ->
                    count
        )
        gameModel.player.level
        gameModel.effects


bonusHpNextCycle : GameModel -> Int
bonusHpNextCycle gameModel =
    Array.foldl
        (\effect count ->
            when effect is
                CycleStartEffect.PlayerHeals { amount } ->
                    count + amount

                CycleStartEffect.PlayerTakesDamage { amount } ->
                    count - amount

                _ ->
                    count
        )
        0
        gameModel.effects


bonusMaxHpNextCycle : GameModel -> Int
bonusMaxHpNextCycle gameModel =
    Array.foldl
        (\effect count ->
            when effect is
                CycleStartEffect.PlayerMaxHPChanges { amount } ->
                    count + amount

                _ ->
                    count
        )
        0
        gameModel.effects


bonusLevelsNextCycle : GameModel -> Int
bonusLevelsNextCycle gameModel =
    Array.foldl
        (\effect count ->
            when effect is
                CycleStartEffect.PlayerLevelsUp ->
                    count + 1

                _ ->
                    count
        )
        0
        gameModel.effects
