playerNextCycleStatsDesc : GameModel -> Array { stat : Stat, amount : Int }
playerNextCycleStatsDesc gameModel =
    let
        pink =
            pointsForStatNextCycle Stat.Pink gameModel

        yellow =
            pointsForStatNextCycle Stat.Yellow gameModel

        green =
            pointsForStatNextCycle Stat.Green gameModel

        blue =
            pointsForStatNextCycle Stat.Blue gameModel

        purple =
            pointsForStatNextCycle Stat.Purple gameModel
    in
    [ { stat = Stat.Pink, amount = pink }
    , { stat = Stat.Yellow, amount = yellow }
    , { stat = Stat.Green, amount = green }
    , { stat = Stat.Blue, amount = blue }
    , { stat = Stat.Purple, amount = purple }
    ]
        |> Array.sortBy (\{ stat, amount } -> -amount)


randomStat : Array Stat -> Array Stat -> Random.Generator Stat
randomStat with without =
    Random.uniform Stat.Pink
        ([ Stat.Yellow, Stat.Green, Stat.Blue, Stat.Purple ]
            |> Array.prepend with
            |> Array.keepIf (\stat -> not (Array.member stat without))
        )


collapseRequirements : Array QuestReq.Requirement -> Array QuestReq.Requirement
collapseRequirements reqs =
    Array.foldl
        (\req collapsed ->
            let
                stat =
                    QuestReq.stat req
            in
            collapsed
                |> Array.findFirst (\req_ -> QuestReq.stat req_ == stat)
                |> Maybe.map
                    (\{ index } ->
                        Array.update index (\req_ -> QuestReq.init stat (QuestReq.total req_ + QuestReq.total req)) collapsed
                    )
                |> Maybe.withDefault (Array.pushLast req collapsed)
        )
        []
        reqs


collapsePointEffects : Array { stat : Stat, amount : Int, duration : Duration } -> Array { stat : Stat, amount : Int, duration : Duration }
collapsePointEffects effects =
    Array.foldl
        (\effect collapsed ->
            collapsed
                |> Array.findFirst (\effect_ -> effect_.stat == effect.stat && effect_.duration == effect.duration)
                |> Maybe.map
                    (\{ index } ->
                        Array.update index
                            (\effect_ ->
                                { stat = effect.stat
                                , amount = effect.amount + effect_.amount
                                , duration = effect.duration
                                }
                            )
                            collapsed
                    )
                |> Maybe.withDefault (Array.pushLast effect collapsed)
        )
        []
        effects
