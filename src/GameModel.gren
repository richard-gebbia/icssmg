module GameModel exposing (..)

import CycleStartEffect exposing (CycleStartEffect)
import Dict exposing (Dict)
import Duration exposing (Duration)
import Ids exposing (ID, Ids)
import Math
import Msg exposing (Msg)
import Player exposing (Player)
import Quest exposing (Quest)
import Quest.Requirement as QuestReq
import Random
import Stat exposing (Stat)


type alias GameModel =
    { player : Player
    , cycle : Int
    , ids : Ids
    , randomSeed : Random.Seed
    , quests : Dict ID Quest
    , effects : Array CycleStartEffect
    , primaryQuestGenerator : QuestGenerator
    , questGeneratorsByName : Dict String QuestGenerator
    , generateQuestCounter : Int
    }


init : { game : GameModel, command : Cmd Msg }
init =
    { game =
        { player =
            { hp = 10
            , maxHP = 10
            , level = 1
            , pink = 0
            , yellow = 0
            , green = 0
            , blue = 0
            , purple = 0
            , white = 1
            , wild = 1
            , pinkTotalForCycle = 0
            , yellowTotalForCycle = 0
            , greenTotalForCycle = 0
            , blueTotalForCycle = 0
            , purpleTotalForCycle = 0
            , whiteTotalForCycle = 1
            , wildTotalForCycle = 1
            }
        , cycle = 1
        , ids = Ids.init
        , randomSeed = Random.initialSeed 0
        , quests =
            Dict.empty
                |> Dict.set 1
                    { title = "Initial Venture"
                    , requirements = [ QuestReq.init Stat.White 1 ]
                    , duration = Duration.Permanent
                    , completionEffects =
                        [ CycleStartEffect.PlayerGetsPoints { stat = Stat.Pink, amount = 1, duration = Duration.Temp { cyclesLeft = 0 } }
                        , CycleStartEffect.PlayerGetsPoints { stat = Stat.Yellow, amount = 1, duration = Duration.Temp { cyclesLeft = 0 } }
                        , CycleStartEffect.PlayerGetsPoints { stat = Stat.Green, amount = 1, duration = Duration.Temp { cyclesLeft = 0 } }
                        , CycleStartEffect.PlayerGetsPoints { stat = Stat.Blue, amount = 1, duration = Duration.Temp { cyclesLeft = 0 } }
                        , CycleStartEffect.PlayerGetsPoints { stat = Stat.Purple, amount = 1, duration = Duration.Temp { cyclesLeft = 0 } }
                        ]
                    , expirationEffects = []
                    , isRecurring = False
                    }
        , effects = []
        , primaryQuestGenerator = primaryQuestGenerator
        , questGeneratorsByName =
            Dict.empty
                |> Dict.set "Level Up" levelUp
                |> Dict.set "Find Out" findOut
        , generateQuestCounter = 0
        }
    , command = Random.generate Msg.GeneratedInitialSeed Random.independentSeed
    }


withInitialRandomSeed : Random.Seed -> GameModel -> GameModel
withInitialRandomSeed seed gameModel =
    { gameModel
    | randomSeed = seed
    }


nextCycleStartState : GameModel -> GameModel
nextCycleStartState gameModel =
    let
        playerAtCycleStart : Player
        playerAtCycleStart =
            Player.nextCycleStartState gameModel.player

        oldEffects : Array CycleStartEffect
        oldEffects =
            tentativeEffects gameModel

        newEffects : Array CycleStartEffect
        newEffects =
            Array.mapAndKeepJust
                (\effect ->
                    when effect is
                        CycleStartEffect.PlayerGetsPoints effect_ ->
                            when effect_.duration is
                                Duration.Temp { cyclesLeft } ->
                                    if cyclesLeft <= 0 then
                                        Nothing

                                    else
                                        Just
                                            (CycleStartEffect.PlayerGetsPoints
                                                { effect_
                                                | duration = Duration.Temp { cyclesLeft = cyclesLeft - 1 }
                                                }
                                            )

                                Duration.Permanent ->
                                    Just effect

                        CycleStartEffect.PlayerLevelsUp ->
                            Nothing

                        CycleStartEffect.PlayerHeals _ ->
                            Nothing

                        CycleStartEffect.PlayerMaxHPChanges _ ->
                            Nothing

                        CycleStartEffect.PlayerTakesDamage _ ->
                            Nothing

                        CycleStartEffect.SpawnQuest _ ->
                            Nothing
                )
                oldEffects

        playerWithNewPointsAndLevel : Player
        playerWithNewPointsAndLevel =
            Array.foldl
                (\effect playerIter ->
                    when effect is
                        CycleStartEffect.PlayerLevelsUp ->
                            { playerIter | level = playerIter.level + 1 }

                        CycleStartEffect.PlayerGetsPoints { stat, amount } ->
                            Player.withPointsChanged stat (\points -> points + amount) playerIter

                        CycleStartEffect.PlayerHeals { amount } ->
                            Player.withHpChanged amount playerIter

                        CycleStartEffect.PlayerMaxHPChanges { amount } ->
                            Player.withMaxHpChanged amount playerIter

                        CycleStartEffect.PlayerTakesDamage { amount } ->
                            Player.withHpChanged -amount playerIter

                        CycleStartEffect.SpawnQuest _ ->
                            playerIter
                )
                playerAtCycleStart
                oldEffects
                |> Player.afterEffectsApplied

        spawnedQuestsAndRandomSeedAndIds : { quests : Dict ID Quest, randomSeed : Random.Seed, ids : Ids }
        spawnedQuestsAndRandomSeedAndIds =
            Array.foldl
                (\effect questsAndSeedAndIds ->
                    when effect is
                        CycleStartEffect.SpawnQuest { generatorId, extraData } ->
                            Dict.get generatorId gameModel.questGeneratorsByName
                                |> Maybe.map
                                    (\questGen ->
                                        let
                                            questAndSeed : { quest : Quest, randomSeed : Random.Seed }
                                            questAndSeed =
                                                generateQuest questGen gameModel questsAndSeedAndIds.randomSeed extraData

                                            idAndIds : { id : ID, nextIds : Ids }
                                            idAndIds =
                                                Ids.next questsAndSeedAndIds.ids
                                        in
                                        { quests = Dict.set idAndIds.id questAndSeed.quest questsAndSeedAndIds.quests
                                        , randomSeed = questAndSeed.randomSeed
                                        , ids = idAndIds.nextIds
                                        }
                                    )
                                |> Maybe.withDefault questsAndSeedAndIds

                        _ ->
                            questsAndSeedAndIds
                )
                { quests = Dict.empty, randomSeed = gameModel.randomSeed, ids = gameModel.ids }
                oldEffects

        randomNewQuestAndSeedAndIds : Random.Seed -> Ids -> { quests : Dict ID Quest, randomSeed : Random.Seed, ids : Ids }
        randomNewQuestAndSeedAndIds randomSeed ids =
            let
                questAndSeed =
                    generateQuest gameModel.primaryQuestGenerator gameModel randomSeed ""

                idAndIds : { id : ID, nextIds : Ids }
                idAndIds =
                    Ids.next ids
            in
            { quests = Dict.empty |> Dict.set idAndIds.id questAndSeed.quest
            , randomSeed = questAndSeed.randomSeed
            , ids = idAndIds.nextIds
            }

        newQuestForCycleAndIds : { quests : Dict ID Quest, randomSeed : Random.Seed, ids : Ids }
        newQuestForCycleAndIds =
            let
                randomSeed : Random.Seed
                randomSeed =
                    spawnedQuestsAndRandomSeedAndIds.randomSeed

                ids : Ids
                ids =
                    spawnedQuestsAndRandomSeedAndIds.ids
            in
            if gameModel.generateQuestCounter == 0 then
                randomNewQuestAndSeedAndIds randomSeed ids

            else
                { quests = Dict.empty, randomSeed = randomSeed, ids = ids }

        newQuests : Dict ID Quest
        newQuests =
            gameModel.quests
                |> Dict.union spawnedQuestsAndRandomSeedAndIds.quests
                |> Dict.union newQuestForCycleAndIds.quests
                |> Dict.mapAndKeepJust
                    (\_ quest ->
                        let
                            newQuestAndIsStillThere : { quest : Quest, isStillThere : Bool }
                            newQuestAndIsStillThere =
                                Quest.nextCycleStartState quest
                        in
                        if newQuestAndIsStillThere.isStillThere then
                            Just newQuestAndIsStillThere.quest

                        else
                            Nothing
                    )

        finalNewQuestsAndSeedAndIds : { quests : Dict ID Quest, randomSeed : Random.Seed, ids : Ids }
        finalNewQuestsAndSeedAndIds =
            let
                initState =
                    { quests = newQuests, randomSeed = newQuestForCycleAndIds.randomSeed, ids = newQuestForCycleAndIds.ids }
            in
            if Dict.count newQuests < 3 then
                Array.foldl
                    (\_ { quests, randomSeed, ids } ->
                        let
                            questsAndSeedAndId =
                                randomNewQuestAndSeedAndIds randomSeed ids
                        in
                        { quests = Dict.union quests questsAndSeedAndId.quests
                        , randomSeed = questsAndSeedAndId.randomSeed
                        , ids = questsAndSeedAndId.ids
                        }
                    )
                    initState
                    (Array.range (Dict.count newQuests + 1) 3)

            else
                initState
    in
    { gameModel
    | player = playerWithNewPointsAndLevel
    , quests = finalNewQuestsAndSeedAndIds.quests
    , cycle = gameModel.cycle + 1
    , effects = newEffects
    , randomSeed = finalNewQuestsAndSeedAndIds.randomSeed
    , ids = finalNewQuestsAndSeedAndIds.ids
    , generateQuestCounter = Math.modBy 3 (gameModel.generateQuestCounter + 1)
    }


doesPlayerMeetQuestRequirements : Player -> Quest -> Bool
doesPlayerMeetQuestRequirements player quest =
    Array.all
        (\requirement -> QuestReq.total requirement <= Player.pointsForStat (QuestReq.stat requirement) player)
        quest.requirements


withPlayerPuttingNormalPointsIntoQuestReq : ID -> Int -> Stat -> Int -> GameModel -> GameModel
withPlayerPuttingNormalPointsIntoQuestReq questId reqIdx stat points gameModel =
    { gameModel
    | player = Player.withPointsChanged stat (\oldPoints -> oldPoints - points) gameModel.player
    , quests = Dict.update questId (Maybe.map (Quest.withNormalPointsTowardRequirement points reqIdx)) gameModel.quests
    }


withPlayerPuttingWildPointIntoQuestReq : ID -> Int -> GameModel -> GameModel
withPlayerPuttingWildPointIntoQuestReq questId reqIdx gameModel =
    { gameModel
    | player = Player.withPointsChanged Stat.Wild (\oldPoints -> oldPoints - 1) gameModel.player
    , quests = Dict.update questId (Maybe.map (Quest.withWildPointTowardRequirement reqIdx)) gameModel.quests
    }


withPlayerPuttingMaxPointsIntoQuestReq : ID -> Int -> Stat -> GameModel -> GameModel
withPlayerPuttingMaxPointsIntoQuestReq questId reqIdx stat gameModel =
    let
        pointsNeeded : Int
        pointsNeeded =
            Dict.get questId gameModel.quests
                |> Maybe.map (Quest.pointsNeededToCompleteReq reqIdx)
                |> Maybe.withDefault 0

        pointsHeld : Int
        pointsHeld =
            Player.pointsForStat stat gameModel.player

        points : Int
        points =
            min pointsNeeded pointsHeld
    in
    { gameModel
    | player = Player.withPointsChanged stat (\oldPoints -> oldPoints - points) gameModel.player
    , quests = Dict.update questId (Maybe.map (Quest.withNormalPointsTowardRequirement points reqIdx)) gameModel.quests
    }


withPlayerRemovingNormalPointsFromQuestReq : ID -> Int -> Stat -> Int -> GameModel -> GameModel
withPlayerRemovingNormalPointsFromQuestReq questId reqIdx stat points gameModel =
    { gameModel
    | player = Player.withPointsChanged stat (\oldPoints -> oldPoints + points) gameModel.player
    , quests = Dict.update questId (Maybe.map (Quest.withNormalPointsRemovedFromRequirement points reqIdx)) gameModel.quests
    }


withPlayerRemovingWildPointFromQuestReq : ID -> Int -> GameModel -> GameModel
withPlayerRemovingWildPointFromQuestReq questId reqIdx gameModel =
    { gameModel
    | player = Player.withPointsChanged Stat.Wild (\oldPoints -> oldPoints + 1) gameModel.player
    , quests = Dict.update questId (Maybe.map (Quest.withWildPointRemovedFromRequirement reqIdx)) gameModel.quests
    }


withPlayerRemovingAllPiontsFromQuestReq : ID -> Int -> Stat -> GameModel -> GameModel
withPlayerRemovingAllPiontsFromQuestReq questId reqIdx stat gameModel =
    let
        normalPoints : Int
        normalPoints =
            Dict.get questId gameModel.quests
                |> Maybe.map (Quest.normalPointsAddedInCurrentCycle reqIdx)
                |> Maybe.withDefault 0

        wildPoints : Int
        wildPoints =
            Dict.get questId gameModel.quests
                |> Maybe.map (Quest.wildPointsAddedInCurrentCycle reqIdx)
                |> Maybe.withDefault 0
    in
    { gameModel
    | player =
        gameModel.player
            |> Player.withPointsChanged stat (\oldPoints -> oldPoints + normalPoints)
            |> Player.withPointsChanged Stat.Wild (\oldPoints -> oldPoints + wildPoints)
    , quests = Dict.update questId (Maybe.map (Quest.withAllPointsRemovedFromRequirement reqIdx)) gameModel.quests
    }


pointsForStatNextCycle : Stat -> GameModel -> Int
pointsForStatNextCycle stat gameModel =
    Array.foldl
        (\effect count ->
            when effect is
                CycleStartEffect.PlayerGetsPoints effect_ ->
                    if effect_.stat == stat then
                        when effect_.duration is
                            Duration.Temp { cyclesLeft } ->
                                if 0 < cyclesLeft then
                                    count + effect_.amount

                                else
                                    count

                            Duration.Permanent ->
                                count + effect_.amount

                    else
                        count

                _ ->
                    count
        )
        0
        (tentativeEffects gameModel)


bonusHpNextCycle : GameModel -> Int
bonusHpNextCycle gameModel =
    Array.foldl
        (\effect count ->
            when effect is
                CycleStartEffect.PlayerHeals { amount } ->
                    count + amount

                CycleStartEffect.PlayerMaxHPChanges { amount } ->
                    if 0 < amount then
                        count + amount

                    else
                        count

                CycleStartEffect.PlayerTakesDamage { amount } ->
                    count - amount

                _ ->
                    count
        )
        0
        (tentativeEffects gameModel)


bonusMaxHpNextCycle : GameModel -> Int
bonusMaxHpNextCycle gameModel =
    Array.foldl
        (\effect count ->
            when effect is
                CycleStartEffect.PlayerMaxHPChanges { amount } ->
                    count + amount

                _ ->
                    count
        )
        0
        (tentativeEffects gameModel)


bonusLevelsNextCycle : GameModel -> Int
bonusLevelsNextCycle gameModel =
    Array.foldl
        (\effect count ->
            when effect is
                CycleStartEffect.PlayerLevelsUp ->
                    count + 1

                _ ->
                    count
        )
        0
        (tentativeEffects gameModel)


tentativeEffects : GameModel -> Array CycleStartEffect
tentativeEffects { quests, effects } =
    effects
        ++ Array.mapAndFlatten
            (\quest ->
                if not (Quest.isCompleted quest) then
                    when quest.duration is
                        Duration.Temp { cyclesLeft } ->
                            if cyclesLeft <= 1 then
                                quest.expirationEffects

                            else
                                []

                        Duration.Permanent ->
                            []

                else
                    quest.completionEffects
            )
            (Dict.values quests)



-- Quest Generators


type QuestGenerator
    = QuestGen (GameModel -> Random.Seed -> String -> { quest : Quest, randomSeed : Random.Seed })


generateQuest : QuestGenerator -> GameModel -> Random.Seed -> String -> { quest : Quest, randomSeed : Random.Seed }
generateQuest questGen game seed extraData =
    when questGen is
        QuestGen g ->
            g game seed extraData


primaryQuestGenerator : QuestGenerator
primaryQuestGenerator =
    QuestGen
        (\game seed _extraData ->
            let
                options : Random.Generator QuestGenerator
                options =
                    Random.weighted
                        { weight = 50, value = easyProcedural }
                        [ { weight = 20, value = mediumProcedural }
                        , { weight = 9, value = hardProcedural }
                        , { weight = 9, value = levelUpSpawner }
                        , { weight = 1, value = levelUp }
                        , { weight = 5, value = fuckAround }
                        , { weight = 1, value = pinkLevelUp }
                        , { weight = 1, value = yellowLevelUp }
                        , { weight = 1, value = greenLevelUp }
                        , { weight = 1, value = blueLevelUp }
                        , { weight = 1, value = purpleLevelUp }
                        , { weight = 1, value = whiteLevelUp }
                        ]

                questGenAndSeed =
                    Random.step options seed
            in
            generateQuest questGenAndSeed.value game questGenAndSeed.seed ""
        )


levelUp : QuestGenerator
levelUp =
    QuestGen
        (\game seed _extraData ->
            { quest =
                { title = "Level Up " ++ romanNumeral game.player.level
                , requirements = [ QuestReq.init Stat.White (2 ^ game.player.level) ]
                , duration = Duration.Permanent
                , completionEffects = [ CycleStartEffect.PlayerLevelsUp ]
                , expirationEffects = []
                , isRecurring = False
                }
            , randomSeed = seed
            }
        )


levelUpSpawner : QuestGenerator
levelUpSpawner =
    QuestGen
        (\game seed _extraData ->
            { quest =
                { title = "Venture into the Unknown " ++ romanNumeral game.player.level
                , requirements =
                    [ QuestReq.init Stat.Pink game.player.level
                    , QuestReq.init Stat.Yellow game.player.level
                    , QuestReq.init Stat.Green game.player.level
                    , QuestReq.init Stat.Blue game.player.level
                    , QuestReq.init Stat.Purple game.player.level
                    ]
                , duration = Duration.Temp { cyclesLeft = 7 }
                , completionEffects = [ CycleStartEffect.SpawnQuest { generatorId = "Level Up", extraData = "" } ]
                , expirationEffects = []
                , isRecurring = False
                }
            , randomSeed = seed
            }
        )


fuckAround : QuestGenerator
fuckAround =
    QuestGen
        (\game seed _extraData ->
            let
                statAndSeed1 =
                    Random.step randomStat seed

                statAndSeed2 =
                    Random.step randomStat statAndSeed1.seed

                statAndSeed3 =
                    Random.step randomStat statAndSeed2.seed

                requirements =
                    [ QuestReq.init statAndSeed1.value 1
                    , QuestReq.init statAndSeed2.value 1
                    , QuestReq.init statAndSeed3.value 1
                    ]

                extraDataEncoder : Stat -> String
                extraDataEncoder stat =
                    when stat is
                        Stat.Pink ->
                            "pink"

                        Stat.Yellow ->
                            "yellow"

                        Stat.Green ->
                            "green"

                        Stat.Blue ->
                            "blue"

                        Stat.Purple ->
                            "purple"

                        _ ->
                            "nothing"
            in
            { quest =
                { title = "Nagging Curiosity " ++ romanNumeral game.player.level
                , requirements = requirements
                , duration = Duration.Temp { cyclesLeft = 4 }
                , completionEffects =
                    [ CycleStartEffect.SpawnQuest { generatorId = "Find Out", extraData = extraDataEncoder statAndSeed1.value }
                    , CycleStartEffect.SpawnQuest { generatorId = "Find Out", extraData = extraDataEncoder statAndSeed2.value }
                    , CycleStartEffect.SpawnQuest { generatorId = "Find Out", extraData = extraDataEncoder statAndSeed3.value }
                    ]
                , expirationEffects = []
                , isRecurring = False
                }
            , randomSeed = statAndSeed3.seed
            }
        )


findOut : QuestGenerator
findOut =
    QuestGen
        (\game seed extraData ->
            let
                stat : Stat
                stat =
                    when extraData is
                        "pink" ->
                            Stat.Pink

                        "yellow" ->
                            Stat.Yellow

                        "green" ->
                            Stat.Green

                        "blue" ->
                            Stat.Blue

                        "purple" ->
                            Stat.Purple

                        _ ->
                            Stat.White
            in
            { quest =
                { title = "Attack of the Bullshit Planet " ++ romanNumeral game.player.level
                , requirements = [ QuestReq.init stat (game.player.level * 3) ]
                , duration = Duration.Temp { cyclesLeft = 4 }
                , completionEffects =
                    [ CycleStartEffect.PlayerGetsPoints { stat = Stat.Pink, amount = 2 * game.player.level, duration = Duration.Temp { cyclesLeft = 3 } }
                    , CycleStartEffect.PlayerGetsPoints { stat = Stat.Yellow, amount = 2 * game.player.level, duration = Duration.Temp { cyclesLeft = 3 } }
                    , CycleStartEffect.PlayerGetsPoints { stat = Stat.Green, amount = 2 * game.player.level, duration = Duration.Temp { cyclesLeft = 3 } }
                    , CycleStartEffect.PlayerGetsPoints { stat = Stat.Blue, amount = 2 * game.player.level, duration = Duration.Temp { cyclesLeft = 3 } }
                    , CycleStartEffect.PlayerGetsPoints { stat = Stat.Purple, amount = 2 * game.player.level, duration = Duration.Temp { cyclesLeft = 3 } }
                    , CycleStartEffect.PlayerGetsPoints { stat = Stat.White, amount = 2 * game.player.level, duration = Duration.Temp { cyclesLeft = 3 } }
                    ]
                , expirationEffects = [ CycleStartEffect.PlayerTakesDamage { amount = 2 } ]
                , isRecurring = False
                }
            , randomSeed = seed
            }
        )


