module GameModel exposing (..)

import CycleStartEffect exposing (CycleStartEffect)
import Dict exposing (Dict)
import Duration exposing (Duration)
import Ids exposing (ID, Ids)
import Msg exposing (Msg)
import Player exposing (Player)
import Quest exposing (Quest)
import Quest.Requirement as QuestReq
import Random
import Stat exposing (Stat)


type alias GameModel =
    { player : Player
    , cycle : Int
    , ids : Ids
    , randomSeed : Random.Seed
    , quests : Dict ID Quest
    , effects : Array CycleStartEffect
    , primaryQuestGenerator : QuestGenerator
    , questGeneratorsByName : Dict String QuestGenerator
    }


init : { game : GameModel, command : Cmd Msg }
init =
    { game =
        { player =
            { hp = 10
            , maxHP = 10
            , level = 0
            , pink = 3
            , yellow = 0
            , green = 3
            , blue = 1
            , purple = 0
            , white = 0
            , wild = 2
            , pinkTotalForCycle = 0
            , yellowTotalForCycle = 0
            , greenTotalForCycle = 2
            , blueTotalForCycle = 1
            , purpleTotalForCycle = 0
            , whiteTotalForCycle = 0
            , wildTotalForCycle = 2
            }
        , cycle = 1
        , ids = Ids.init
        , randomSeed = Random.initialSeed 0
        , quests =
            Dict.empty
                |> Dict.set 1
                    { title = "First Quest"
                    , requirements = [ QuestReq.init Stat.Blue 1 ]
                    , duration = Duration.Permanent
                    , completionEffects = [ CycleStartEffect.PlayerLevelsUp ]
                    , generatorName = "BarBaz"
                    , isRecurring = False
                    }
                |> Dict.set 2
                    { title = "Second Quest"
                    , requirements =
                        [ QuestReq.init Stat.Green 12 |> QuestReq.withNormalPointsAdded 1 |> QuestReq.nextCycleStartState
                        , QuestReq.init Stat.Pink 3 |> QuestReq.withNormalPointsAdded 2 |> QuestReq.nextCycleStartState
                        , QuestReq.init Stat.Purple 1 |> QuestReq.withNormalPointsAdded 1 |> QuestReq.nextCycleStartState
                        ]
                    , duration = Duration.Temp { cyclesLeft = 3 }
                    , completionEffects =
                        [ CycleStartEffect.PlayerGetsPoints { stat = Stat.Green, amount = 2, duration = Duration.Temp { cyclesLeft = 2 } }
                        , CycleStartEffect.PlayerGetsPoints { stat = Stat.White, amount = 1, duration = Duration.Temp { cyclesLeft = 1 } }
                        , CycleStartEffect.PlayerGetsPoints { stat = Stat.Pink, amount = 3, duration = Duration.Permanent }
                        ]
                    , generatorName = "FooBar"
                    , isRecurring = False
                    }
                |> Dict.set 3
                    { title = "Third Quest"
                    , requirements = [ QuestReq.init Stat.Blue 1 ]
                    , duration = Duration.Permanent
                    , completionEffects = [ CycleStartEffect.PlayerLevelsUp ]
                    , generatorName = "FooBaz"
                    , isRecurring = False
                    }
                |> Dict.set 4
                    { title = "Venture into the Unknown " ++ romanNumeral 1
                    , requirements = [ QuestReq.init Stat.Pink 1 ]
                    , duration = Duration.Temp { cyclesLeft = 7 }
                    , completionEffects = [ CycleStartEffect.SpawnQuest { generatorId = "Level Up" } ]
                    , generatorName = "Level Up Spawner"
                    , isRecurring = False
                    }
        , effects =
            [ CycleStartEffect.PlayerGetsPoints { stat = Stat.Yellow, amount = 2, duration = Duration.Temp { cyclesLeft = 3 } }
            , CycleStartEffect.PlayerHeals { amount = 2 }
            , CycleStartEffect.PlayerMaxHPChanges { amount = -1 }
            , CycleStartEffect.PlayerLevelsUp
            , CycleStartEffect.PlayerLevelsUp
            ]
        , primaryQuestGenerator = levelUp
        , questGeneratorsByName =
            Dict.empty
                |> Dict.set "Level Up" levelUp
                |> Dict.set "Level Up Spawner" levelUpSpawner
        }
    , command = Random.generate Msg.GeneratedInitialSeed Random.independentSeed
    }


withInitialRandomSeed : Random.Seed -> GameModel -> GameModel
withInitialRandomSeed seed gameModel =
    { gameModel
    | randomSeed = seed
    }


nextCycleStartState : GameModel -> GameModel
nextCycleStartState gameModel =
    let
        playerAtCycleStart : Player
        playerAtCycleStart =
            Player.nextCycleStartState gameModel.player

        oldEffects : Array CycleStartEffect
        oldEffects =
            tentativeEffects gameModel

        newEffects : Array CycleStartEffect
        newEffects =
            Array.mapAndKeepJust
                (\effect ->
                    when effect is
                        CycleStartEffect.PlayerGetsPoints effect_ ->
                            when effect_.duration is
                                Duration.Temp { cyclesLeft } ->
                                    if cyclesLeft <= 0 then
                                        Nothing

                                    else
                                        Just
                                            (CycleStartEffect.PlayerGetsPoints
                                                { effect_
                                                | duration = Duration.Temp { cyclesLeft = cyclesLeft - 1 }
                                                }
                                            )

                                Duration.Permanent ->
                                    Just effect

                        CycleStartEffect.PlayerLevelsUp ->
                            Nothing

                        CycleStartEffect.PlayerHeals _ ->
                            Nothing

                        CycleStartEffect.PlayerMaxHPChanges _ ->
                            Nothing

                        CycleStartEffect.PlayerTakesDamage _ ->
                            Nothing

                        CycleStartEffect.SpawnQuest _ ->
                            Nothing
                )
                oldEffects

        playerWithNewPointsAndLevel : Player
        playerWithNewPointsAndLevel =
            Array.foldl
                (\effect playerIter ->
                    when effect is
                        CycleStartEffect.PlayerLevelsUp ->
                            { playerIter | level = playerIter.level + 1 }

                        CycleStartEffect.PlayerGetsPoints { stat, amount } ->
                            Player.withPointsChanged stat (\points -> points + amount) playerIter

                        CycleStartEffect.PlayerHeals { amount } ->
                            Player.withHpChanged amount playerIter

                        CycleStartEffect.PlayerMaxHPChanges { amount } ->
                            Player.withMaxHpChanged amount playerIter

                        CycleStartEffect.PlayerTakesDamage { amount } ->
                            Player.withHpChanged -amount playerIter

                        CycleStartEffect.SpawnQuest _ ->
                            playerIter
                )
                playerAtCycleStart
                oldEffects
                |> Player.adjustedForMaxHP

        spawnedQuestsAndRandomSeedAndIds : { quests : Dict ID Quest, randomSeed : Random.Seed, ids : Ids }
        spawnedQuestsAndRandomSeedAndIds =
            Array.foldl
                (\effect questsAndSeedAndIds ->
                    when effect is
                        CycleStartEffect.SpawnQuest { generatorId } ->
                            Dict.get generatorId gameModel.questGeneratorsByName
                                |> Maybe.map
                                    (\questGen ->
                                        let
                                            questAndSeed : { quest : Quest, randomSeed : Random.Seed }
                                            questAndSeed =
                                                generateQuest questGen generatorId gameModel questsAndSeedAndIds.randomSeed

                                            idAndIds : { id : ID, nextIds : Ids }
                                            idAndIds =
                                                Ids.next questsAndSeedAndIds.ids
                                        in
                                        { quests = Dict.set idAndIds.id questAndSeed.quest questsAndSeedAndIds.quests
                                        , randomSeed = questAndSeed.randomSeed
                                        , ids = idAndIds.nextIds
                                        }
                                    )
                                |> Maybe.withDefault questsAndSeedAndIds

                        _ ->
                            questsAndSeedAndIds
                )
                { quests = Dict.empty, randomSeed = gameModel.randomSeed, ids = gameModel.ids }
                oldEffects
                |> Debug.log "hullo?"

        newQuests : Dict ID Quest
        newQuests =
            gameModel.quests
                |> Dict.mapAndKeepJust
                    (\_ quest ->
                        if Quest.isCompleted quest then
                            Nothing

                        else
                            when quest.duration is
                                Duration.Temp { cyclesLeft } ->
                                    if cyclesLeft <= 0 then
                                        Nothing

                                    else
                                        Just { quest | duration = Duration.Temp { cyclesLeft = cyclesLeft - 1 } }

                                Duration.Permanent ->
                                    Just quest
                    )
                |> Dict.union spawnedQuestsAndRandomSeedAndIds.quests
    in
    { gameModel
    | player = playerWithNewPointsAndLevel
    , quests = newQuests
    , cycle = gameModel.cycle + 1
    , effects = newEffects
    , randomSeed = spawnedQuestsAndRandomSeedAndIds.randomSeed
    , ids = spawnedQuestsAndRandomSeedAndIds.ids
    }


doesPlayerMeetQuestRequirements : Player -> Quest -> Bool
doesPlayerMeetQuestRequirements player quest =
    Array.all
        (\requirement -> QuestReq.total requirement <= Player.pointsForStat (QuestReq.stat requirement) player)
        quest.requirements


withPlayerPuttingNormalPointsIntoQuestReq : ID -> Int -> Stat -> Int -> GameModel -> GameModel
withPlayerPuttingNormalPointsIntoQuestReq questId reqIdx stat points gameModel =
    { gameModel
    | player = Player.withPointsChanged stat (\oldPoints -> oldPoints - points) gameModel.player
    , quests = Dict.update questId (Maybe.map (Quest.withNormalPointsTowardRequirement points reqIdx)) gameModel.quests
    }


withPlayerPuttingWildPointIntoQuestReq : ID -> Int -> GameModel -> GameModel
withPlayerPuttingWildPointIntoQuestReq questId reqIdx gameModel =
    { gameModel
    | player = Player.withPointsChanged Stat.Wild (\oldPoints -> oldPoints - 1) gameModel.player
    , quests = Dict.update questId (Maybe.map (Quest.withWildPointTowardRequirement reqIdx)) gameModel.quests
    }


withPlayerPuttingMaxPointsIntoQuestReq : ID -> Int -> Stat -> GameModel -> GameModel
withPlayerPuttingMaxPointsIntoQuestReq questId reqIdx stat gameModel =
    let
        pointsNeeded : Int
        pointsNeeded =
            Dict.get questId gameModel.quests
                |> Maybe.map (Quest.pointsNeededToCompleteReq reqIdx)
                |> Maybe.withDefault 0

        pointsHeld : Int
        pointsHeld =
            Player.pointsForStat stat gameModel.player

        points : Int
        points =
            min pointsNeeded pointsHeld
    in
    { gameModel
    | player = Player.withPointsChanged stat (\oldPoints -> oldPoints - points) gameModel.player
    , quests = Dict.update questId (Maybe.map (Quest.withNormalPointsTowardRequirement points reqIdx)) gameModel.quests
    }


withPlayerRemovingNormalPointsFromQuestReq : ID -> Int -> Stat -> Int -> GameModel -> GameModel
withPlayerRemovingNormalPointsFromQuestReq questId reqIdx stat points gameModel =
    { gameModel
    | player = Player.withPointsChanged stat (\oldPoints -> oldPoints + points) gameModel.player
    , quests = Dict.update questId (Maybe.map (Quest.withNormalPointsRemovedFromRequirement points reqIdx)) gameModel.quests
    }


withPlayerRemovingWildPointFromQuestReq : ID -> Int -> GameModel -> GameModel
withPlayerRemovingWildPointFromQuestReq questId reqIdx gameModel =
    { gameModel
    | player = Player.withPointsChanged Stat.Wild (\oldPoints -> oldPoints + 1) gameModel.player
    , quests = Dict.update questId (Maybe.map (Quest.withWildPointRemovedFromRequirement reqIdx)) gameModel.quests
    }


withPlayerRemovingAllPiontsFromQuestReq : ID -> Int -> Stat -> GameModel -> GameModel
withPlayerRemovingAllPiontsFromQuestReq questId reqIdx stat gameModel =
    let
        normalPoints : Int
        normalPoints =
            Dict.get questId gameModel.quests
                |> Maybe.map (Quest.normalPointsAddedInCurrentCycle reqIdx)
                |> Maybe.withDefault 0

        wildPoints : Int
        wildPoints =
            Dict.get questId gameModel.quests
                |> Maybe.map (Quest.wildPointsAddedInCurrentCycle reqIdx)
                |> Maybe.withDefault 0
    in
    { gameModel
    | player =
        gameModel.player
            |> Player.withPointsChanged stat (\oldPoints -> oldPoints + normalPoints)
            |> Player.withPointsChanged Stat.Wild (\oldPoints -> oldPoints + wildPoints)
    , quests = Dict.update questId (Maybe.map (Quest.withAllPointsRemovedFromRequirement reqIdx)) gameModel.quests
    }


pointsForStatNextCycle : Stat -> GameModel -> Int
pointsForStatNextCycle stat gameModel =
    Array.foldl
        (\effect count ->
            when effect is
                CycleStartEffect.PlayerGetsPoints effect_ ->
                    if effect_.stat == stat then
                        when effect_.duration is
                            Duration.Temp { cyclesLeft } ->
                                if 0 < cyclesLeft then
                                    count + effect_.amount

                                else
                                    count

                            Duration.Permanent ->
                                count + effect_.amount

                    else
                        count

                _ ->
                    count
        )
        0
        (tentativeEffects gameModel)


bonusHpNextCycle : GameModel -> Int
bonusHpNextCycle gameModel =
    Array.foldl
        (\effect count ->
            when effect is
                CycleStartEffect.PlayerHeals { amount } ->
                    count + amount

                CycleStartEffect.PlayerMaxHPChanges { amount } ->
                    if 0 < amount then
                        count + amount

                    else
                        count

                CycleStartEffect.PlayerTakesDamage { amount } ->
                    count - amount

                _ ->
                    count
        )
        0
        (tentativeEffects gameModel)


bonusMaxHpNextCycle : GameModel -> Int
bonusMaxHpNextCycle gameModel =
    Array.foldl
        (\effect count ->
            when effect is
                CycleStartEffect.PlayerMaxHPChanges { amount } ->
                    count + amount

                _ ->
                    count
        )
        0
        (tentativeEffects gameModel)


bonusLevelsNextCycle : GameModel -> Int
bonusLevelsNextCycle gameModel =
    Array.foldl
        (\effect count ->
            when effect is
                CycleStartEffect.PlayerLevelsUp ->
                    count + 1

                _ ->
                    count
        )
        0
        (tentativeEffects gameModel)


tentativeEffects : GameModel -> Array CycleStartEffect
tentativeEffects { quests, effects } =
    effects
        ++ Array.mapAndFlatten
            (\quest ->
                if not (Quest.isCompleted quest) then
                    []

                else
                    quest.completionEffects
            )
            (Dict.values quests)



-- Quest Generators


type QuestGenerator
    = QuestGen (String -> GameModel -> Random.Seed -> { quest : Quest, randomSeed : Random.Seed })


generateQuest : QuestGenerator -> String -> GameModel -> Random.Seed -> { quest : Quest, randomSeed : Random.Seed }
generateQuest questGen name game seed =
    when questGen is
        QuestGen g ->
            g name game seed


levelUp : QuestGenerator
levelUp =
    QuestGen
        (\name game seed ->
            { quest =
                { title = "Level Up " ++ romanNumeral game.player.level
                , requirements = [ QuestReq.init Stat.White (2 ^ game.player.level) ]
                , duration = Duration.Permanent
                , completionEffects = [ CycleStartEffect.PlayerLevelsUp ]
                , generatorName = name
                , isRecurring = False
                }
            , randomSeed = seed
            }
        )


levelUpSpawner : QuestGenerator
levelUpSpawner =
    QuestGen
        (\name game seed ->
            { quest =
                { title = "Venture into the Unknown " ++ romanNumeral game.player.level
                , requirements =
                    [ QuestReq.init Stat.Pink game.player.level
                    , QuestReq.init Stat.Yellow game.player.level
                    , QuestReq.init Stat.Green game.player.level
                    , QuestReq.init Stat.Blue game.player.level
                    , QuestReq.init Stat.Purple game.player.level
                    ]
                , duration = Duration.Temp { cyclesLeft = 7 }
                , completionEffects = [ CycleStartEffect.SpawnQuest { generatorId = "Level Up" } ]
                , generatorName = name
                , isRecurring = False
                }
            , randomSeed = seed
            }
        )


romanNumeral : Int -> String
romanNumeral x =
    let
        aux : Int -> String -> String
        aux y soFar =
            if 1000 <= y then
                aux (y - 1000) (soFar ++ "M")

            else if 900 <= y then
                aux (y - 900) (soFar ++ "CM")

            else if 500 <= y then
                aux (y - 500) (soFar ++ "D")

            else if 400 <= y then
                aux (y - 400) (soFar ++ "CD")

            else if 100 <= y then
                aux (y - 100) (soFar ++ "C")

            else if 90 <= y then
                aux (y - 90) (soFar ++ "XC")

            else if 50 <= y then
                aux (y - 50) (soFar ++ "L")

            else if 40 <= y then
                aux (y - 40) (soFar ++ "XL")

            else if 10 <= y then
                aux (y - 10) (soFar ++ "X")

            else if 9 <= y then
                aux (y - 9) (soFar ++ "IX")

            else if 5 <= y then
                aux (y - 5) (soFar ++ "V")

            else if 4 <= y then
                aux (y - 4) (soFar ++ "IV")

            else if 1 <= y then
                aux (y - 1) (soFar ++ "I")

            else
                soFar
    in
    aux x ""
