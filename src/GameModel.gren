statChain1 : Stat -> QuestGenerator
statChain1 stat =
    QuestGen
        (\game seed extraData ->
            { quest =
                { id = "Stat Chain 1 " ++ Stat.toString stat
                , title = "Journey to the " ++ Stat.shape stat ++ " Nebula"
                , requirements = [ QuestReq.init stat (game.player.level * 2) ]
                , duration = Duration.Temp { cyclesLeft = 3 }
                , completionEffects =
                    [ CycleStartEffect.SpawnQuest
                        { generatorId = "Stat Chain 2"
                        , extraData = Stat.toString stat
                        }
                    ]
                , expirationEffects = []
                }
            , randomSeed = seed
            }
        )


statChain2 : QuestGenerator
statChain2 =
    QuestGen
        (\game seed extraData ->
            let
                stat =
                    Stat.fromString extraData
                        |> Maybe.withDefault Stat.White
            in
            { quest =
                { id = "Stat Chain 2 " ++ Stat.toString stat
                , title = "The Gooey " ++ Stat.shape stat ++ " Center"
                , requirements = [ QuestReq.init stat (game.player.level * 5) ]
                , duration = Duration.Temp { cyclesLeft = 5 }
                , completionEffects =
                    [ CycleStartEffect.SpawnQuest
                        { generatorId = "Stat Chain 3"
                        , extraData = extraData
                        }
                    ]
                , expirationEffects = [ CycleStartEffect.PlayerTakesDamage { amount = 3 } ]
                }
            , randomSeed = seed
            }
        )


statChain3 : QuestGenerator
statChain3 =
    QuestGen
        (\game seed extraData ->
            let
                stat =
                    Stat.fromString extraData
                        |> Maybe.withDefault Stat.White
            in
            { quest =
                { id = "Stat Chain 3 " ++ Stat.toString stat
                , title = "Escape from the " ++ Stat.shape stat ++ " Event Horizon"
                , requirements =
                    Array.mapAndKeepJust
                        (\stat_ ->
                            if stat == stat_ then
                                Nothing

                            else
                                Just (QuestReq.init stat_ (game.player.level * 2))
                        )
                        [ Stat.Pink, Stat.Yellow, Stat.Green, Stat.Blue, Stat.Purple, Stat.White ]
                , duration = Duration.Temp { cyclesLeft = 6 }
                , completionEffects =
                    [ CycleStartEffect.SpawnQuest
                        { generatorId = "Recurring Stat Pump"
                        , extraData = extraData
                        }
                    ]
                , expirationEffects = [ CycleStartEffect.PlayerTakesDamage { amount = 5 } ]
                }
            , randomSeed = seed
            }
        )


recurringStatPump : QuestGenerator
recurringStatPump =
    QuestGen
        (\_game seed extraData ->
            let
                stat =
                    Stat.fromString extraData
                        |> Maybe.withDefault Stat.White

                statAndSeed1 =
                    Random.step (randomStat [ Stat.White ] []) seed

                statAndSeed2 =
                    Random.step (randomStat [ Stat.White ] []) statAndSeed1.seed
            in
            { quest =
                { id = "Recurring Stat Pump " ++ Stat.toString stat
                , title = "Channel the " ++ Stat.shape stat ++ " Nebula"
                , requirements =
                    [ QuestReq.init statAndSeed1.value 1
                    , QuestReq.init statAndSeed2.value 1
                    ]
                        |> collapseRequirements
                , duration = Duration.Temp { cyclesLeft = 3 }
                , completionEffects =
                    [ CycleStartEffect.PlayerGetsPoints
                        { stat = stat
                        , amount = 3
                        , duration = Duration.Temp { cyclesLeft = 2 }
                        }
                    , CycleStartEffect.SpawnQuest
                        { generatorId = "Recurring Stat Pump"
                        , extraData = extraData
                        }
                    ]
                , expirationEffects =
                    [ CycleStartEffect.SpawnQuest
                        { generatorId = "Recurring Stat Pump"
                        , extraData = extraData
                        }
                    ]
                }
            , randomSeed = statAndSeed2.seed
            }
        )


romanNumeral : Int -> String
romanNumeral x =
    let
        aux : Int -> String -> String
        aux y soFar =
            if 1000 <= y then
                aux (y - 1000) (soFar ++ "M")

            else if 900 <= y then
                aux (y - 900) (soFar ++ "CM")

            else if 500 <= y then
                aux (y - 500) (soFar ++ "D")

            else if 400 <= y then
                aux (y - 400) (soFar ++ "CD")

            else if 100 <= y then
                aux (y - 100) (soFar ++ "C")

            else if 90 <= y then
                aux (y - 90) (soFar ++ "XC")

            else if 50 <= y then
                aux (y - 50) (soFar ++ "L")

            else if 40 <= y then
                aux (y - 40) (soFar ++ "XL")

            else if 10 <= y then
                aux (y - 10) (soFar ++ "X")

            else if 9 <= y then
                aux (y - 9) (soFar ++ "IX")

            else if 5 <= y then
                aux (y - 5) (soFar ++ "V")

            else if 4 <= y then
                aux (y - 4) (soFar ++ "IV")

            else if 1 <= y then
                aux (y - 1) (soFar ++ "I")

            else
                soFar
    in
    aux x ""


