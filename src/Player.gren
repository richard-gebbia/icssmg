module Player exposing (..)

import Duration exposing (Duration)
import Stat exposing (Stat)


type alias Player =
    { hp : Int
    , maxHP : Int
    , level : Int
    , pink : Int
    , yellow : Int
    , green : Int
    , blue : Int
    , purple : Int
    , white : Int
    , pinkTotalForCycle : Int
    , yellowTotalForCycle : Int
    , greenTotalForCycle : Int
    , blueTotalForCycle : Int
    , purpleTotalForCycle : Int
    , whiteTotalForCycle : Int
    }


nextCycleStartState : Player -> Player
nextCycleStartState player =
    { player
    | pink = 0
    , yellow = 0
    , green = 0
    , blue = 0
    , purple = 0
    , white = 0
    , pinkTotalForCycle = 0
    , yellowTotalForCycle = 0
    , greenTotalForCycle = 0
    , blueTotalForCycle = 0
    , purpleTotalForCycle = 0
    , whiteTotalForCycle = 0
    }


pointsForStat : Stat -> Player -> Int
pointsForStat stat { pink, yellow, green, blue, purple, white } =
    when stat is
        Stat.Pink ->
            pink

        Stat.Yellow ->
            yellow

        Stat.Green ->
            green

        Stat.Blue ->
            blue

        Stat.Purple ->
            purple

        Stat.White ->
            white


totalPointsForCycleForStat : Stat -> Player -> Int
totalPointsForCycleForStat stat player =
    when stat is
        Stat.Pink ->
            player.pinkTotalForCycle

        Stat.Yellow ->
            player.yellowTotalForCycle

        Stat.Green ->
            player.greenTotalForCycle

        Stat.Blue ->
            player.blueTotalForCycle

        Stat.Purple ->
            player.purpleTotalForCycle

        Stat.White ->
            player.whiteTotalForCycle


withPointsChanged : Stat -> (Int -> Int) -> Player -> Player
withPointsChanged stat statChange player =
    when stat is
        Stat.Pink ->
            { player | pink = statChange player.pink }

        Stat.Yellow ->
            { player | yellow = statChange player.yellow }

        Stat.Green ->
            { player | green = statChange player.green }

        Stat.Blue ->
            { player | blue = statChange player.blue }

        Stat.Purple ->
            { player | purple = statChange player.purple }

        Stat.White ->
            { player | white = statChange player.white }


withExtraPointsMidCycle : Stat -> Int -> Player -> Player
withExtraPointsMidCycle stat amount player =
    when stat is
        Stat.Pink ->
            { player
            | pink = player.pink + amount
            , pinkTotalForCycle = player.pinkTotalForCycle + amount
            }

        Stat.Yellow ->
            { player
            | yellow = player.yellow + amount
            , yellowTotalForCycle = player.yellowTotalForCycle + amount
            }

        Stat.Green ->
            { player
            | green = player.green + amount
            , greenTotalForCycle = player.greenTotalForCycle + amount
            }

        Stat.Blue ->
            { player
            | blue = player.blue + amount
            , blueTotalForCycle = player.blueTotalForCycle + amount
            }

        Stat.Purple ->
            { player
            | purple = player.purple + amount
            , purpleTotalForCycle = player.purpleTotalForCycle + amount
            }

        Stat.White ->
            { player
            | white = player.white + amount
            , whiteTotalForCycle = player.whiteTotalForCycle + amount
            }
