module Player exposing (..)

import Duration exposing (Duration)
import Stat exposing (Stat)


type alias Player =
    { level : Int
    , pink : Int
    , yellow : Int
    , green : Int
    , blue : Int
    , purple : Int
    , white : Int
    }


cycleStartState : Player -> Player
cycleStartState player =
    { player
    | pink = 0
    , yellow = 0
    , green = 0
    , blue = 0
    , purple = 0
    , white = 0
    }


pointsForStat : Stat -> Player -> Int
pointsForStat stat { pink, yellow, green, blue, purple, white } =
    when stat is
        Stat.Pink ->
            pink

        Stat.Yellow ->
            yellow

        Stat.Green ->
            green

        Stat.Blue ->
            blue

        Stat.Purple ->
            purple

        Stat.White ->
            white


withPointsChanged : Stat -> (Int -> Int) -> Player -> Player
withPointsChanged stat statChange player =
    when stat is
        Stat.Pink ->
            { player | pink = statChange player.pink }

        Stat.Yellow ->
            { player | yellow = statChange player.yellow }

        Stat.Green ->
            { player | green = statChange player.green }

        Stat.Blue ->
            { player | blue = statChange player.blue }

        Stat.Purple ->
            { player | purple = statChange player.purple }

        Stat.White ->
            { player | white = statChange player.white }
