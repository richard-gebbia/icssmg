module Main exposing (..)

import Browser
import GameModel exposing (GameModel)
import Html exposing (Html)
import Html.Attributes as HtmlAttrs
import Msg exposing (Msg)
import Process
import Task
import View


main : Program {} Model Msg
main =
    Browser.element
        { init = init
        , view = view
        , update = update
        , subscriptions = subscriptions
        }


type alias Model =
    { gameModel : GameModel
    , isCommittingCycle : Bool
    }


init : {} -> { model : Model, command : Cmd Msg }
init _ =
    { model = { gameModel = GameModel.init, isCommittingCycle = False }
    , command = Cmd.none
    }


view : Model -> Html Msg
view { gameModel, isCommittingCycle } =
    Html.main_ [] [ View.view gameModel isCommittingCycle ]


update : Msg -> Model -> { model : Model, command : Cmd Msg }
update msg model =
    when msg is
        Msg.PlayerPutPointIntoQuestReq { questIdx, reqIdx, stat } ->
            { model = { model | gameModel = GameModel.withPlayerPuttingPointsIntoQuestReq questIdx reqIdx stat 1 model.gameModel }
            , command = Cmd.none
            }

        Msg.PlayerPutsMaxPointsIntoQuestReq { questIdx, reqIdx, stat } ->
            { model = { model | gameModel = GameModel.withPlayerPuttingMaxPointsIntoQuestReq questIdx reqIdx stat model.gameModel }
            , command = Cmd.none
            }

        Msg.PlayerRemovesPointFromQuestReq { questIdx, reqIdx, stat } ->
            { model = { model | gameModel = GameModel.withPlayerRemovingPointsFromQuestReq questIdx reqIdx stat 1 model.gameModel }
            , command = Cmd.none
            }

        Msg.PlayerRemovesAllPointsFromQuestReq { questIdx, reqIdx, stat } ->
            { model = { model | gameModel = GameModel.withPlayerRemovingAllPiontsFromQuestReq questIdx reqIdx stat model.gameModel }
            , command = Cmd.none
            }

        Msg.PlayerCommitsCurrentCycle ->
            { model = { model | isCommittingCycle = True }
            , command = Process.sleep 1000 |> Task.perform (\_ -> Msg.CommitCycleAnimationEnds)
            }

        Msg.CommitCycleAnimationEnds ->
            { model =
                { model
                | isCommittingCycle = False
                , gameModel = GameModel.nextCycleStartState model.gameModel
                }
            , command = Cmd.none
            }


subscriptions : Model -> Sub Msg
subscriptions _ =
    Sub.none
