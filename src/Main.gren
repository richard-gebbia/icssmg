module Main exposing (..)

import Browser
import GameModel exposing (GameModel)
import Html exposing (Html)
import Html.Attributes as HtmlAttrs
import Msg exposing (Msg)
import Process
import Task
import View


main : Program {} Model Msg
main =
    Browser.element
        { init = init
        , view = view
        , update = update
        , subscriptions = subscriptions
        }


type alias Model =
    { gameModel : GameModel
    , isCommittingCycle : Bool
    }


init : {} -> { model : Model, command : Cmd Msg }
init _ =
    let
        initialGameModelAndCommand =
            GameModel.init

        game =
            initialGameModelAndCommand.game

        command =
            initialGameModelAndCommand.command
    in
    { model = { gameModel = game, isCommittingCycle = False }
    , command = command
    }


view : Model -> Html Msg
view { gameModel, isCommittingCycle } =
    Html.main_ [] [ View.view gameModel isCommittingCycle ]


update : Msg -> Model -> { model : Model, command : Cmd Msg }
update msg model =
    when msg is
        Msg.GeneratedInitialSeed seed ->
            { model = { model | gameModel = GameModel.withInitialRandomSeed seed model.gameModel }
            , command = Cmd.none
            }

        Msg.PlayerPutPointIntoQuestReq { questId, reqIdx, stat } ->
            { model = { model | gameModel = GameModel.withPlayerPuttingNormalPointsIntoQuestReq questId reqIdx stat 1 model.gameModel }
            , command = Cmd.none
            }

        Msg.PlayerPutWildPointIntoQuestReq { questId, reqIdx } ->
            { model = { model | gameModel = GameModel.withPlayerPuttingWildPointIntoQuestReq questId reqIdx model.gameModel }
            , command = Cmd.none
            }

        Msg.PlayerPutMaxPointsIntoQuestReq { questId, reqIdx, stat } ->
            { model = { model | gameModel = GameModel.withPlayerPuttingMaxPointsIntoQuestReq questId reqIdx stat model.gameModel }
            , command = Cmd.none
            }

        Msg.PlayerRemovesPointFromQuestReq { questId, reqIdx, stat } ->
            { model = { model | gameModel = GameModel.withPlayerRemovingNormalPointsFromQuestReq questId reqIdx stat 1 model.gameModel }
            , command = Cmd.none
            }

        Msg.PlayerRemovesWildPointFromQuestReq { questId, reqIdx } ->
            { model = { model | gameModel = GameModel.withPlayerRemovingWildPointFromQuestReq questId reqIdx model.gameModel }
            , command = Cmd.none
            }

        Msg.PlayerRemovesAllPointsFromQuestReq { questId, reqIdx, stat } ->
            { model = { model | gameModel = GameModel.withPlayerRemovingAllPiontsFromQuestReq questId reqIdx stat model.gameModel }
            , command = Cmd.none
            }

        Msg.PlayerCommitsCurrentCycle ->
            { model = { model | isCommittingCycle = True }
            , command = Process.sleep 500 |> Task.perform (\_ -> Msg.CommitCycleAnimationEnds)
            }

        Msg.CommitCycleAnimationEnds ->
            { model =
                { model
                | isCommittingCycle = False
                , gameModel = GameModel.nextCycleStartState model.gameModel
                }
            , command = Cmd.none
            }


subscriptions : Model -> Sub Msg
subscriptions _ =
    Sub.none
