module Main exposing (..)

import Browser
import GameModel exposing (GameModel)
import Html exposing (Html)
import Html.Attributes as HtmlAttrs
import View


main : Program {} Model Msg
main =
    Browser.element
        { init = init
        , view = view
        , update = update
        , subscriptions = subscriptions
        }


type alias Model =
    { gameModel : GameModel }


type alias Msg =
    {}


init : {} -> { model : Model, command : Cmd Msg }
init _ =
    { model = { gameModel = GameModel.init }
    , command = Cmd.none
    }


view : Model -> Html Msg
view { gameModel } =
    Html.main_ []
        [ Html.div [ HtmlAttrs.class "game container" ]
            [ View.viewCompletingQuests gameModel ]
        ]


update : Msg -> Model -> { model : Model, command : Cmd Msg }
update _ model =
    { model = model
    , command = Cmd.none
    }


subscriptions : Model -> Sub Msg
subscriptions _ =
    Sub.none
