module Quest.Requirement exposing (Requirement, init, isCompleted, nextCycleStartState, normalPointsAddedInCurrentCycle, pointsNeededToComplete, pointsTowardCompletion, stat, total, wildPointsAddedInCurrentCycle, withAllPointsRemoved, withNormalPointsAdded, withNormalPointsRemoved, withWildPointAdded, withWildPointRemoved)

import Stat exposing (Stat)


type alias Requirement =
    { stat_ : Stat
    , amount : Int
    , pointsAddedPreviously : Int
    , normalPointsAddedInCurrentCycle_ : Int
    , wildPointsAddedInCurrentCycle_ : Int
    }


init : Stat -> Int -> Requirement
init stat_ amount =
    { stat_ = stat_
    , amount = amount
    , pointsAddedPreviously = 0
    , normalPointsAddedInCurrentCycle_ = 0
    , wildPointsAddedInCurrentCycle_ = 0
    }


pointsTowardCompletion : Requirement -> Int
pointsTowardCompletion requirement =
    requirement.pointsAddedPreviously
        + requirement.normalPointsAddedInCurrentCycle_
        + requirement.wildPointsAddedInCurrentCycle_


isCompleted : Requirement -> Bool
isCompleted requirement =
    requirement.amount <= pointsTowardCompletion requirement


stat : Requirement -> Stat
stat =
    .stat_


total : Requirement -> Int
total =
    .amount


withNormalPointsAdded : Int -> Requirement -> Requirement
withNormalPointsAdded points requirement =
    { requirement
    | normalPointsAddedInCurrentCycle_ = requirement.normalPointsAddedInCurrentCycle_ + points
    }


withNormalPointsRemoved : Int -> Requirement -> Requirement
withNormalPointsRemoved points requirement =
    { requirement
    | normalPointsAddedInCurrentCycle_ = requirement.normalPointsAddedInCurrentCycle_ - points
    }


withWildPointAdded : Requirement -> Requirement
withWildPointAdded requirement =
    { requirement
    | wildPointsAddedInCurrentCycle_ = requirement.wildPointsAddedInCurrentCycle_ + 1
    }


withWildPointRemoved : Requirement -> Requirement
withWildPointRemoved requirement =
    { requirement
    | wildPointsAddedInCurrentCycle_ = requirement.wildPointsAddedInCurrentCycle_ - 1
    }


withAllPointsRemoved : Requirement -> Requirement
withAllPointsRemoved requirement =
    { requirement
    | normalPointsAddedInCurrentCycle_ = 0
    , wildPointsAddedInCurrentCycle_ = 0
    }


normalPointsAddedInCurrentCycle : Requirement -> Int
normalPointsAddedInCurrentCycle =
    .normalPointsAddedInCurrentCycle_


wildPointsAddedInCurrentCycle : Requirement -> Int
wildPointsAddedInCurrentCycle =
    .wildPointsAddedInCurrentCycle_


pointsNeededToComplete : Requirement -> Int
pointsNeededToComplete requirement =
    requirement.amount - pointsTowardCompletion requirement


nextCycleStartState : Requirement -> Requirement
nextCycleStartState requirement =
    { requirement
    | pointsAddedPreviously = requirement.pointsAddedPreviously + requirement.normalPointsAddedInCurrentCycle_
    , normalPointsAddedInCurrentCycle_ = 0
    }
