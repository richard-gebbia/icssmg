module Quest exposing (..)

import CycleStartEffect exposing (CycleStartEffect)
import Duration exposing (Duration)
import Quest.Requirement as Requirement exposing (Requirement)
import Stat exposing (Stat)


type alias Quest =
    { title : String
    , requirements : Array Requirement
    , duration : Duration
    , completionEffects : Array CycleStartEffect
    , expirationEffects : Array CycleStartEffect
    }


withNormalPointsTowardRequirement : Int -> Int -> Quest -> Quest
withNormalPointsTowardRequirement points reqIdx quest =
    { quest
    | requirements = Array.update reqIdx (Requirement.withNormalPointsAdded points) quest.requirements
    }


withNormalPointsRemovedFromRequirement : Int -> Int -> Quest -> Quest
withNormalPointsRemovedFromRequirement points reqIdx quest =
    { quest
    | requirements = Array.update reqIdx (Requirement.withNormalPointsRemoved points) quest.requirements
    }


withWildPointTowardRequirement : Int -> Quest -> Quest
withWildPointTowardRequirement reqIdx quest =
    { quest
    | requirements = Array.update reqIdx Requirement.withWildPointAdded quest.requirements
    }


withWildPointRemovedFromRequirement : Int -> Quest -> Quest
withWildPointRemovedFromRequirement reqIdx quest =
    { quest
    | requirements = Array.update reqIdx Requirement.withWildPointRemoved quest.requirements
    }


withAllPointsRemovedFromRequirement : Int -> Quest -> Quest
withAllPointsRemovedFromRequirement reqIdx quest =
    { quest
    | requirements = Array.update reqIdx Requirement.withAllPointsRemoved quest.requirements
    }


normalPointsAddedInCurrentCycle : Int -> Quest -> Int
normalPointsAddedInCurrentCycle reqIdx quest =
    Array.get reqIdx quest.requirements
        |> Maybe.map Requirement.normalPointsAddedInCurrentCycle
        |> Maybe.withDefault 0


wildPointsAddedInCurrentCycle : Int -> Quest -> Int
wildPointsAddedInCurrentCycle reqIdx quest =
    Array.get reqIdx quest.requirements
        |> Maybe.map Requirement.wildPointsAddedInCurrentCycle
        |> Maybe.withDefault 0


pointsNeededToCompleteReq : Int -> Quest -> Int
pointsNeededToCompleteReq reqIdx quest =
    Array.get reqIdx quest.requirements
        |> Maybe.map Requirement.pointsNeededToComplete
        |> Maybe.withDefault 0


isCompleted : Quest -> Bool
isCompleted quest =
    Array.all Requirement.isCompleted quest.requirements


nextCycleStartState : Quest -> { quest : Quest, isStillThere : Bool }
nextCycleStartState quest =
    let
        newQuest : Quest
        newQuest =
            { quest
            | requirements = Array.map Requirement.nextCycleStartState quest.requirements
            , duration =
                when quest.duration is
                    Duration.Temp { cyclesLeft } ->
                        Duration.Temp { cyclesLeft = cyclesLeft - 1 }

                    Duration.Permanent ->
                        Duration.Permanent
            }
    in
    if isCompleted quest then
        { quest = quest, isStillThere = False }

    else
        when newQuest.duration is
            Duration.Temp { cyclesLeft } ->
                { quest = newQuest, isStillThere = 0 < cyclesLeft }

            Duration.Permanent ->
                { quest = newQuest, isStillThere = True }
