module Quest exposing (..)

import Duration exposing (Duration)
import Quest.Requirement as Requirement exposing (Requirement)
import Stat exposing (Stat)


type alias Quest =
    { title : String
    , requirements : Array Requirement
    , duration : Duration
    }


withPointsTowardRequirement : Int -> Int -> Quest -> Quest
withPointsTowardRequirement points reqIdx quest =
    { quest
    | requirements = Array.update reqIdx (Requirement.withPointsAdded points) quest.requirements
    }


withPointsRemovedFromRequirement : Int -> Int -> Quest -> Quest
withPointsRemovedFromRequirement points reqIdx quest =
    { quest
    | requirements = Array.update reqIdx (Requirement.withPointsRemoved points) quest.requirements
    }


pointsAddedInCurrentCycle : Int -> Quest -> Int
pointsAddedInCurrentCycle reqIdx quest =
    Array.get reqIdx quest.requirements
        |> Maybe.map Requirement.pointsAddedInCurrentCycle
        |> Maybe.withDefault 0


pointsNeededToCompleteReq : Int -> Quest -> Int
pointsNeededToCompleteReq reqIdx quest =
    Array.get reqIdx quest.requirements
        |> Maybe.map Requirement.pointsNeededToComplete
        |> Maybe.withDefault 0


isCompleted : Quest -> Bool
isCompleted quest =
    Array.all Requirement.isCompleted quest.requirements
