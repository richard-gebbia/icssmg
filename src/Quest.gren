module Quest exposing (..)

import Duration exposing (Duration)
import Quest.Requirement as Requirement exposing (Requirement)
import Stat exposing (Stat)


type alias Quest =
    { title : String
    , requirements : Array Requirement
    , duration : Duration
    }


withPointsTowardRequirement : Int -> Int -> Quest -> Quest
withPointsTowardRequirement points reqIdx quest =
    { quest
    | requirements = Array.update reqIdx (Requirement.withPointsAdded points) quest.requirements
    }
