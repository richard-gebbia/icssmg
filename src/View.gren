module View exposing (..)

import CycleStartEffect exposing (CycleStartEffect)
import Dict
import Duration
import GameModel exposing (GameModel)
import Html exposing (Html)
import Html.Attributes as HtmlAttrs
import Html.Events as HtmlEvents
import Html.Keyed as HtmlKeyed
import Ids exposing (ID)
import Json.Decode as JsonDecode
import Msg exposing (Msg)
import Player exposing (Player)
import Quest exposing (Quest)
import Quest.Requirement as QuestReq
import Stat exposing (Stat)


view : GameModel -> Bool -> Html Msg
view gameModel isCommittingCycle =
    Html.section [ HtmlAttrs.class "game" ]
        [ viewQuests gameModel isCommittingCycle
        , viewPlayerInfo gameModel isCommittingCycle
        ]


viewQuests : GameModel -> Bool -> Html Msg
viewQuests { player, quests, numQuestsCompleted } isCommittingCycle =
    Html.section [ HtmlAttrs.class "completing-quests-frame" ]
        [ Html.h2 []
            [ Html.text
                ("Quests (Available: "
                    ++ String.fromInt (Dict.count quests)
                    ++ ", Total Completed: "
                    ++ String.fromInt numQuestsCompleted
                    ++ ")"
                )
            ]
        , HtmlKeyed.ul [ HtmlAttrs.class "quests-list" ]
            (Dict.map (viewQuest player isCommittingCycle) quests |> Dict.values)
        ]


viewQuest : Player -> Bool -> ID -> Quest -> { key : String, node : Html Msg }
viewQuest player isCommittingCycle questId quest =
    let
        isCompleted : Bool
        isCompleted =
            Quest.isCompleted quest
    in
    { key = String.fromInt questId
    , node =
        Html.li
            [ HtmlAttrs.class "quest-grid-container"
            , HtmlAttrs.classList [ { class = "completed-committed", enabled = isCompleted && isCommittingCycle } ]
            ]
            [ Html.div
                [ HtmlAttrs.class "quest-container"
                , HtmlAttrs.classList [ { class = "quest-completed", enabled = isCompleted } ]
                ]
                [ Html.div [ HtmlAttrs.class "quest-title" ]
                    [ Html.text
                        (if isCompleted && isCommittingCycle then
                            "QUEST COMPLETED!"

                         else
                            quest.spawner
                                |> Maybe.map (\spawner -> quest.title ++ " (spawned by " ++ spawner ++ ")")
                                |> Maybe.withDefault quest.title
                        )
                    ]
                , Html.div [ HtmlAttrs.class "pips" ]
                    (Array.indexedMap (pipRow player questId) quest.requirements |> Array.flatten)
                , Html.hr [] []
                , Html.div [ HtmlAttrs.class "rewards-section" ]
                    [ Html.b [] [ Html.text "On completion:" ]
                    , Html.ul []
                        (Array.map viewEffectListItem quest.completionEffects)
                    ]
                , Html.hr [] []
                , Html.div []
                    [ Html.text
                        (when quest.duration is
                            Duration.Temp { cyclesLeft } ->
                                if cyclesLeft <= 1 then
                                    "Goes away next cycle"

                                else
                                    "Goes away in " ++ String.fromInt cyclesLeft ++ " cycles"

                            Duration.Permanent ->
                                "Never goes away"
                        )
                    ]
                , if Array.isEmpty quest.expirationEffects then
                    Html.text ""

                  else
                    Html.div [ HtmlAttrs.class "consequences-section" ]
                        [ Html.b [] [ Html.text "When this goes away without being completed:" ]
                        , Html.ul []
                            (Array.map viewEffectListItem quest.expirationEffects)
                        ]
                ]
            ]
    }


pipRow : Player -> Int -> Int -> QuestReq.Requirement -> Array (Html Msg)
pipRow player questId reqIdx requirement =
    let
        stat : Stat
        stat =
            QuestReq.stat requirement

        isCompleted : Bool
        isCompleted =
            QuestReq.isCompleted requirement

        cantPutInMoreNormalPoints : Bool
        cantPutInMoreNormalPoints =
            Player.pointsForStat stat player <= 0 || isCompleted

        normalPointsInReqThisCycle : Int
        normalPointsInReqThisCycle =
            QuestReq.normalPointsAddedInCurrentCycle requirement

        wildPointsInReqThisCycle : Int
        wildPointsInReqThisCycle =
            QuestReq.wildPointsAddedInCurrentCycle requirement

        reqHasNormalPointsThisCycle : Bool
        reqHasNormalPointsThisCycle =
            0 < normalPointsInReqThisCycle

        reqHasWildPointsThisCycle : Bool
        reqHasWildPointsThisCycle =
            0 < wildPointsInReqThisCycle

        wildImg : Html msg
        wildImg =
            Html.img [ HtmlAttrs.src "img/wild-blob.svg", HtmlAttrs.width 16, HtmlAttrs.height 16 ] []
    in
    [ Html.div
        [ HtmlAttrs.class "pip-row-header"
        , HtmlAttrs.classList [ { class = "completed", enabled = isCompleted } ]
        ]
        [ Html.text
            (String.fromInt (QuestReq.pointsTowardCompletion requirement)
                ++ "/"
                ++ String.fromInt (QuestReq.total requirement)
            )
        ]
    , Html.div [ HtmlAttrs.class "pip-row-buttons" ]
        [ Html.button
            [ HtmlAttrs.type_ "button"
            , HtmlAttrs.disabled cantPutInMoreNormalPoints
            , HtmlEvents.onClick (Msg.PlayerPutPointIntoQuestReq { questId = questId, reqIdx = reqIdx, stat = stat })
            ]
            [ Html.text "+1" ]
        , Html.button
            [ HtmlAttrs.type_ "button"
            , HtmlAttrs.disabled cantPutInMoreNormalPoints
            , HtmlEvents.onClick (Msg.PlayerPutMaxPointsIntoQuestReq { questId = questId, reqIdx = reqIdx, stat = stat })
            ]
            [ Html.text "+Max" ]
        , Html.button
            [ HtmlAttrs.type_ "button"
            , HtmlAttrs.disabled (Player.pointsForStat Stat.Wild player <= 0 || isCompleted)
            , HtmlEvents.onClick (Msg.PlayerPutWildPointIntoQuestReq { questId = questId, reqIdx = reqIdx })
            ]
            [ Html.text "+1", wildImg ]
        , Html.button
            [ HtmlAttrs.type_ "button"
            , HtmlAttrs.disabled (not reqHasNormalPointsThisCycle)
            , HtmlEvents.onClick (Msg.PlayerRemovesPointFromQuestReq { questId = questId, reqIdx = reqIdx, stat = stat })
            ]
            [ Html.text "-1" ]
        , Html.button
            [ HtmlAttrs.type_ "button"
            , HtmlAttrs.disabled (not reqHasWildPointsThisCycle)
            , HtmlEvents.onClick (Msg.PlayerRemovesWildPointFromQuestReq { questId = questId, reqIdx = reqIdx })
            ]
            [ Html.text "-1", wildImg ]
        , Html.button
            [ HtmlAttrs.type_ "button"
            , HtmlAttrs.disabled (not reqHasNormalPointsThisCycle && not reqHasWildPointsThisCycle)
            , HtmlEvents.onClick (Msg.PlayerRemovesAllPointsFromQuestReq { questId = questId, reqIdx = reqIdx, stat = stat })
            ]
            (if not reqHasNormalPointsThisCycle && not reqHasWildPointsThisCycle then
                [ Html.text "-All" ]

             else if reqHasNormalPointsThisCycle && reqHasWildPointsThisCycle then
                [ Html.text ("-All (" ++ String.fromInt normalPointsInReqThisCycle ++ ", " ++ String.fromInt wildPointsInReqThisCycle)
                , wildImg
                , Html.text ")"
                ]

             else if reqHasNormalPointsThisCycle then
                [ Html.text ("-All (" ++ String.fromInt normalPointsInReqThisCycle ++ ")") ]

             else
                [ Html.text ("-All (" ++ String.fromInt wildPointsInReqThisCycle), wildImg, Html.text ")" ]
            )
        ]
    , Html.div [ HtmlAttrs.class "pip-row-pips" ]
        (Array.map
            (\i ->
                pointPip
                    (i < QuestReq.pointsTowardCompletion requirement)
                    (QuestReq.stat requirement)
            )
            (Array.range 0 (QuestReq.total requirement - 1))
        )
    ]


pointPip : Bool -> Stat -> Html msg
pointPip isFulfilled stat =
    let
        classForStat : String
        classForStat =
            when stat is
                Stat.Pink ->
                    "pip-pink"

                Stat.Yellow ->
                    "pip-yellow"

                Stat.Green ->
                    "pip-green"

                Stat.Blue ->
                    "pip-blue"

                Stat.Purple ->
                    "pip-purple"

                Stat.White ->
                    "pip-white"

                _ ->
                    ""

        classForFulfilled : String
        classForFulfilled =
            if isFulfilled then
                " fulfilled"

            else
                ""
    in
    Html.div [ HtmlAttrs.class ("point-pip " ++ classForStat ++ classForFulfilled) ] []


viewEffectListItem : CycleStartEffect -> Html msg
viewEffectListItem effect =
    Html.li [] (viewCycleStartEffect effect)


imgForStat : Stat -> String
imgForStat stat =
    when stat is
        Stat.Pink ->
            "img/pink-diamond.svg"

        Stat.Yellow ->
            "img/yellow-star.svg"

        Stat.Green ->
            "img/green-triangle.svg"

        Stat.Blue ->
            "img/blue-square.svg"

        Stat.Purple ->
            "img/purple-parallelogram.svg"

        Stat.White ->
            "img/white-circle.svg"

        Stat.Wild ->
            "img/wild-blob.svg"


viewCycleStartEffect : CycleStartEffect -> Array (Html msg)
viewCycleStartEffect effect =
    when effect is
        CycleStartEffect.PlayerGetsPoints { stat, amount, duration } ->
            let
                getLine : Html msg
                getLine =
                    Html.text ("Get +" ++ String.fromInt amount)

                img : Html msg
                img =
                    Html.img [ HtmlAttrs.src (imgForStat stat), HtmlAttrs.width 16, HtmlAttrs.height 16 ] []
            in
            when duration is
                Duration.Temp { cyclesLeft } ->
                    if cyclesLeft <= 1 then
                        [ getLine
                        , img
                        , Html.text " next cycle."
                        ]

                    else
                        [ getLine
                        , img
                        , Html.text (" for the next " ++ String.fromInt cyclesLeft ++ " cycles.")
                        ]

                Duration.Permanent ->
                    [ getLine
                    , img
                    , Html.text " permanently."
                    ]

        CycleStartEffect.PlayerLevelsUp ->
            [ Html.text "Level up! (Get an additional "
            , Html.img [ HtmlAttrs.src "img/wild-blob.svg", HtmlAttrs.width 16, HtmlAttrs.height 16 ] []
            , Html.text " each cycle.)"
            ]

        CycleStartEffect.PlayerHeals { amount } ->
            [ Html.text ("Heal " ++ String.fromInt amount ++ " HP.") ]

        CycleStartEffect.PlayerMaxHPChanges { amount } ->
            if amount < 0 then
                [ Html.text ("Decrease max HP by " ++ String.fromInt amount ++ ".") ]

            else
                [ Html.text ("Increase max HP by " ++ String.fromInt amount ++ ".") ]

        CycleStartEffect.PlayerTakesDamage { amount } ->
            [ Html.text ("Take " ++ String.fromInt amount ++ " damage. (Lose this much HP.)") ]

        CycleStartEffect.SpawnQuest _ ->
            [ Html.text "Get a new quest!" ]


viewPlayerInfo : GameModel -> Bool -> Html Msg
viewPlayerInfo gameModel isCommittingCycle =
    let
        bonusHpNextCycle : Int
        bonusHpNextCycle =
            GameModel.bonusHpNextCycle gameModel

        bonusMaxHpNextCycle : Int
        bonusMaxHpNextCycle =
            GameModel.bonusMaxHpNextCycle gameModel

        bonusLevelsNextCycle : Int
        bonusLevelsNextCycle =
            GameModel.bonusLevelsNextCycle gameModel
    in
    Html.section [ HtmlAttrs.class "player-info-panel" ]
        [ Html.div [ HtmlAttrs.class "player-info-panel-top-section" ]
            [ Html.div [ HtmlAttrs.class "player-info-line" ]
                [ Html.b [] [ Html.text "Cycle: " ]
                , Html.text (String.fromInt gameModel.cycle)
                ]
            , Html.div [ HtmlAttrs.class "player-info-line" ]
                [ Html.b [] [ Html.text "HP: " ]
                , Html.text (String.fromInt gameModel.player.hp ++ "/" ++ String.fromInt gameModel.player.maxHP)
                , if not (bonusHpNextCycle == 0) || not (bonusMaxHpNextCycle == 0) then
                    let
                        nextCycleHpText : String
                        nextCycleHpText =
                            if bonusHpNextCycle < 0 then
                                "(" ++ String.fromInt bonusHpNextCycle

                            else
                                "(+" ++ String.fromInt bonusHpNextCycle

                        nextCycleMaxHpText : String
                        nextCycleMaxHpText =
                            if bonusMaxHpNextCycle < 0 then
                                String.fromInt bonusMaxHpNextCycle ++ ")"

                            else
                                "+" ++ String.fromInt bonusMaxHpNextCycle ++ ")"
                    in
                    Html.span
                        [ HtmlAttrs.classList
                            [ { class = "penalty-next-cycle", enabled = bonusHpNextCycle < 0 || bonusMaxHpNextCycle < 0 }
                            , { class = "bonus-next-cycle", enabled = 0 <= bonusHpNextCycle && 0 <= bonusMaxHpNextCycle }
                            ]
                        ]
                        [ Html.text (" " ++ nextCycleHpText ++ "/" ++ nextCycleMaxHpText) ]

                  else
                    Html.text ""
                ]
            , Html.div [ HtmlAttrs.class "player-info-line" ]
                [ Html.b [] [ Html.text "Level: " ]
                , Html.text (String.fromInt gameModel.player.level)
                , if 0 < bonusLevelsNextCycle then
                    Html.span [ HtmlAttrs.class "bonus-next-cycle" ]
                        [ Html.text (" (+" ++ String.fromInt bonusLevelsNextCycle ++ ")") ]

                  else
                    Html.text ""
                ]
            , Html.section [ HtmlAttrs.class "points-list" ]
                (Array.mapAndFlatten (\stat -> viewPointsForStat gameModel stat)
                    [ Stat.Pink
                    , Stat.Yellow
                    , Stat.Green
                    , Stat.Blue
                    , Stat.Purple
                    , Stat.White
                    , Stat.Wild
                    ]
                )
            , Html.section [ HtmlAttrs.class "wild-exchange" ]
                ([ Html.div [] [ Html.text "Wild exchange:" ] ]
                    ++ [ Html.div []
                            (Array.map (viewWildExchangeSlot gameModel.player)
                                [ Player.WildExchangeSlot1
                                , Player.WildExchangeSlot2
                                , Player.WildExchangeSlot3
                                , Player.WildExchangeSlot4
                                ]
                            )
                       , Html.div []
                            [ Html.button
                                [ HtmlAttrs.disabled (not (Player.canExchangeForWild gameModel.player))
                                , HtmlEvents.onClick Msg.WildExchanged
                                ]
                                [ Html.text "Exchange" ]
                            , Html.button
                                [ HtmlAttrs.disabled (not (Player.canUndoLastWildExchange gameModel.player))
                                , HtmlEvents.onClick Msg.LastWildExchangeUndone
                                ]
                                [ Html.text "Undo" ]
                            ]
                       ]
                )
            ]
        , Html.button
            [ HtmlAttrs.type_ "button"
            , HtmlAttrs.class "button complete-button"
            , HtmlAttrs.disabled isCommittingCycle
            , HtmlEvents.onClick Msg.PlayerCommitsCurrentCycle
            ]
            [ Html.text
                (if isCommittingCycle then
                    "Committing Cycle..."

                 else
                    "Next Cycle"
                )
            ]
        ]


viewPointsForStat : GameModel -> Stat -> Array (Html msg)
viewPointsForStat gameModel stat =
    let
        pointsNextCycle : Int
        pointsNextCycle =
            GameModel.pointsForStatInNCycles 1 stat gameModel

        pointsIn2Cycles : Int
        pointsIn2Cycles =
            GameModel.pointsForStatInNCycles 2 stat gameModel

        pointsIn3Cycles : Int
        pointsIn3Cycles =
            GameModel.pointsForStatInNCycles 3 stat gameModel
    in
    viewPoints
        (imgForStat stat)
        (Player.pointsForStat stat gameModel.player)
        (Player.totalPointsForCycleForStat stat gameModel.player)
        pointsNextCycle
        pointsIn2Cycles
        pointsIn3Cycles


viewPoints : String -> Int -> Int -> Int -> Int -> Int -> Array (Html msg)
viewPoints imgSrc numLeftThisCycle totalThisCycle pointsNextCycle pointsIn2Cycles pointsIn3Cycles =
    let
        viewBonusPoints : Int -> Html msg
        viewBonusPoints points =
            Html.div
                [ HtmlAttrs.classList [ { class = "bonus-next-cycle", enabled = 0 < points } ] ]
                [ Html.text ("(" ++ String.fromInt points ++ ")") ]
    in
    [ Html.img [ HtmlAttrs.src imgSrc, HtmlAttrs.width 32, HtmlAttrs.height 32 ] []
    , Html.div [] [ Html.text (String.fromInt numLeftThisCycle) ]
    , Html.div [] [ Html.text "/" ]
    , Html.div [] [ Html.text (String.fromInt totalThisCycle) ]
    , viewBonusPoints pointsNextCycle
    , viewBonusPoints pointsIn2Cycles
    , viewBonusPoints pointsIn3Cycles
    ]


viewWildExchangeSlot : Player -> Player.WildExchangeSlot -> Html Msg
viewWildExchangeSlot player slot =
    let
        options : Array (Maybe Stat)
        options =
            Player.optionsForWildExchangeSlot slot player

        viewOption : Maybe Stat -> Html Msg
        viewOption maybeStat =
            when maybeStat is
                Nothing ->
                    Html.option
                        [ HtmlAttrs.value "-"
                        , HtmlAttrs.selected (Player.wildExchangeSlot slot player == maybeStat)
                        ]
                        [ Html.text "-" ]

                Just stat ->
                    Html.option
                        [ HtmlAttrs.class ("wild-exchange-option-" ++ Stat.toString stat)
                        , HtmlAttrs.value (Stat.toString stat)
                        , HtmlAttrs.selected (Player.wildExchangeSlot slot player == maybeStat)
                        ]
                        [ Html.text (Stat.toString stat) ]

        valueDecoder : JsonDecode.Decoder (Maybe Stat)
        valueDecoder =
            JsonDecode.string
                |> JsonDecode.map Stat.fromString
    in
    Html.select
        [ HtmlEvents.onInput
            (\str ->
                Msg.WildExchangeSlotSelected
                    { slot = slot
                    , stat = Stat.fromString str
                    }
            )
        ]
        (Array.map viewOption options)
