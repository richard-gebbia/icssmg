module View exposing (..)

import Duration
import GameModel exposing (GameModel)
import Html exposing (Html)
import Html.Attributes as HtmlAttrs
import Html.Events as HtmlEvents
import Msg exposing (Msg)
import Player exposing (Player)
import Quest exposing (Quest)
import Quest.Requirement as QuestReq
import Stat exposing (Stat)


view : GameModel -> Html Msg
view gameModel =
    Html.section [ HtmlAttrs.class "game" ]
        [ viewCompletingQuests gameModel
        , viewPlayerInfo gameModel
        ]


viewCompletingQuests : GameModel -> Html Msg
viewCompletingQuests { player, quests } =
    Html.section [ HtmlAttrs.class "completing-quests-frame" ]
        [ Html.section [ HtmlAttrs.class "points-list" ]
            (Array.map (\stat -> viewPointsForStat player stat)
                [ Stat.Pink
                , Stat.Yellow
                , Stat.Green
                , Stat.Blue
                , Stat.Purple
                , Stat.White
                ]
            )
        , Html.section [ HtmlAttrs.class "quests-list" ]
            (Array.indexedMap (viewQuest player) quests)
        ]


viewPointsForStat : Player -> Stat -> Html Msg
viewPointsForStat player stat =
    let
        imgForStat : String
        imgForStat =
            when stat is
                Stat.Pink ->
                    "img/pink-diamond.svg"

                Stat.Yellow ->
                    "img/yellow-star.svg"

                Stat.Green ->
                    "img/green-triangle.svg"

                Stat.Blue ->
                    "img/blue-square.svg"

                Stat.Purple ->
                    "img/purple-parallelogram.svg"

                Stat.White ->
                    "img/white-circle.svg"
    in
    Html.div [ HtmlAttrs.class "stat-point-container" ]
        [ Html.img [ HtmlAttrs.src imgForStat, HtmlAttrs.width 32, HtmlAttrs.height 32 ] []
        , Html.div []
            [ Html.text
                (String.fromInt (Player.pointsForStat stat player)
                    ++ "/"
                    ++ String.fromInt (Player.totalPointsForCycleForStat stat player)
                )
            ]
        ]


viewQuest : Player -> Int -> Quest -> Html Msg
viewQuest player questIdx quest =
    Html.div
        [ HtmlAttrs.class "quest-container"
        , HtmlAttrs.classList [ { class = "quest-completed", enabled = Quest.isCompleted quest } ]
        ]
        [ Html.div [ HtmlAttrs.class "quest-title" ]
            [ Html.text quest.title ]
        , Html.div [ HtmlAttrs.class "pips" ]
            (Array.indexedMap (pipRow player questIdx) quest.requirements)
        , Html.hr [] []
        , Html.div []
            [ Html.text
                (when quest.duration is
                    Duration.Temp { cyclesLeft } ->
                        if cyclesLeft <= 1 then
                            "Goes away next cycle"

                        else
                            "Goes away in " ++ String.fromInt cyclesLeft ++ " cycles"

                    Duration.Permanent ->
                        "Never goes away"
                )
            ]
        ]


pipRow : Player -> Int -> Int -> QuestReq.Requirement -> Html Msg
pipRow player questIdx reqIdx requirement =
    let
        stat : Stat
        stat =
            QuestReq.stat requirement

        playerHasNoPoints : Bool
        playerHasNoPoints =
            Player.pointsForStat stat player <= 0
    in
    Html.div [ HtmlAttrs.class "pip-row" ]
        [ Html.div
            [ HtmlAttrs.class "pip-row-header"
            , HtmlAttrs.classList [ { class = "completed", enabled = QuestReq.isCompleted requirement } ]
            ]
            [ Html.text
                (String.fromInt (QuestReq.pointsTowardCompletion requirement)
                    ++ "/"
                    ++ String.fromInt (QuestReq.total requirement)
                )
            ]
        , Html.button
            [ HtmlAttrs.type_ "button"
            , HtmlAttrs.disabled playerHasNoPoints
            , HtmlEvents.onClick (Msg.PlayerPutPointIntoQuestReq { questIdx = questIdx, reqIdx = reqIdx, stat = stat })
            ]
            [ Html.text "+1" ]
        , Html.button
            [ HtmlAttrs.type_ "button"
            , HtmlAttrs.disabled playerHasNoPoints
            , HtmlEvents.onClick (Msg.PlayerPutsMaxPointsIntoQuestReq { questIdx = questIdx, reqIdx = reqIdx, stat = stat })
            ]
            [ Html.text "+Max" ]
        , Html.button
            [ HtmlAttrs.type_ "button"
            , HtmlAttrs.disabled (QuestReq.pointsAddedInCurrentCycle requirement == 0)
            , HtmlEvents.onClick (Msg.PlayerRemovesPointFromQuestReq { questIdx = questIdx, reqIdx = reqIdx, stat = stat })
            ]
            [ Html.text "-1" ]
        , Html.button
            [ HtmlAttrs.type_ "button"
            , HtmlAttrs.disabled (QuestReq.pointsAddedInCurrentCycle requirement == 0)
            , HtmlEvents.onClick (Msg.PlayerRemovesAllPointsFromQuestReq { questIdx = questIdx, reqIdx = reqIdx, stat = stat })
            ]
            [ Html.text ("-All (" ++ String.fromInt (QuestReq.pointsAddedInCurrentCycle requirement) ++ ")") ]
        , Html.div [ HtmlAttrs.class "pip-row-pips" ]
            (Array.map
                (\i ->
                    pointPip
                        (i < QuestReq.pointsTowardCompletion requirement)
                        (QuestReq.stat requirement)
                )
                (Array.range 0 (QuestReq.total requirement - 1))
            )
        ]


pointPip : Bool -> Stat -> Html msg
pointPip isFulfilled stat =
    let
        classForStat : String
        classForStat =
            when stat is
                Stat.Pink ->
                    "pip-pink"

                Stat.Yellow ->
                    "pip-yellow"

                Stat.Green ->
                    "pip-green"

                Stat.Blue ->
                    "pip-blue"

                Stat.Purple ->
                    "pip-purple"

                Stat.White ->
                    "pip-white"

        classForFulfilled : String
        classForFulfilled =
            if isFulfilled then
                " fulfilled"

            else
                ""
    in
    Html.div [ HtmlAttrs.class ("point-pip " ++ classForStat ++ classForFulfilled) ] []


viewPlayerInfo : GameModel -> Html Msg
viewPlayerInfo gameModel =
    Html.section [ HtmlAttrs.class "player-info-panel" ] []
