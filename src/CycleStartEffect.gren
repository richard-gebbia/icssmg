module CycleStartEffect exposing (..)

import Duration exposing (Duration)
import Stat exposing (Stat)


type CycleStartEffect
    = PlayerGetsPoints { stat : Stat, amount : Int, duration : Duration }
    | PlayerLevelsUp
    | PlayerHeals { amount : Int }
    | PlayerMaxHPChanges { amount : Int }
    | PlayerTakesDamage { amount : Int }
    | SpawnQuest { generatorId : String }
